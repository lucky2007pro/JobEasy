<%inc 
    #include <json/json.h> 
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop Admin | Analitika</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style> 
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .sidebar { background: #ffffff; border-right: 1px solid #e2e8f0; }
        .sidebar-link { color: #64748b; transition: all 0.2s; border-radius: 8px; }
        .sidebar-link:hover { background: #f8fafc; color: #b45309; }
        .sidebar-link.active { background: #fef3c7; color: #b45309; font-weight: 700; }
        .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; }
        .stat-card { border-left: 4px solid #b45309; }
        table th { background: #f8fafc; color: #64748b; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; padding: 12px 24px; border-bottom: 1px solid #e2e8f0; }
        table td { padding: 14px 24px; border-bottom: 1px solid #f1f5f9; font-size: 13px; }
    </style>
</head>
<body class="flex h-screen overflow-hidden">
    <aside class="w-64 sidebar flex flex-col z-30 shrink-0">
        <div class="p-6 flex items-center gap-2">
            <div class="w-7 h-7 bg-amber-700 rounded-lg flex items-center justify-center text-white font-black text-xs">C</div>
            <h2 class="text-base font-bold text-slate-800 tracking-tight">CyberShop Admin</h2>
        </div>
        <nav class="flex-grow px-4 space-y-1 mt-4">
            <a href="/admin/dashboard" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>📦</span> Mahsulotlar
            </a>
            <a href="/admin/analytics" class="sidebar-link active flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>📊</span> Analitika
            </a>
            <a href="/admin/orders" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>🚚</span> Buyurtmalar
            </a>
            <a href="/admin/categories" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>📁</span> Kategoriyalar
            </a>
            <div class="pt-6 mt-6 border-t border-slate-50">
                <p class="text-[9px] text-slate-400 font-black uppercase tracking-widest mb-3 px-4">Tizim</p>
                <a href="/" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs">
                    <span>🌐</span> Saytga o'tish
                </a>
                <a href="/logout" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs text-red-500 hover:bg-red-50">
                    <span>🚪</span> Chiqish
                </a>
            </div>
        </nav>
    </aside>

    <main class="flex-1 overflow-y-auto flex flex-col">
        <header class="h-14 bg-white border-b border-slate-200 flex items-center justify-between px-8 sticky top-0 z-20">
            <div class="flex items-center gap-2 text-[11px] font-bold text-slate-400 uppercase tracking-widest">
                <span>Boshqaruv</span> <span class="text-slate-200">/</span> <span class="text-slate-800">Analitika</span>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-right">
                    <p class="text-[11px] font-bold text-slate-800"><%c++ AdminAnalytics_tmp_stream << @@.get<std::string>("user_name"); %></p>
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter leading-none">Admin Panel</p>
                </div>
            </div>
        </header>

        <div class="p-8 max-w-7xl mx-auto w-full space-y-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <%c++
                    Json::Value stats = @@.get<Json::Value>("stats");
                %>
                <div class="card stat-card p-6 flex flex-col gap-1">
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none">Jami Tushum</p>
                    <p class="text-3xl font-black text-amber-700 tracking-tight"><%c++ AdminAnalytics_tmp_stream << stats["total_revenue"].asString(); %> so'm</p>
                </div>
                <div class="card stat-card p-6 flex flex-col gap-1" style="border-left-color: #0d9488;">
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none">Jami Buyurtmalar</p>
                    <p class="text-3xl font-black text-teal-700 tracking-tight"><%c++ AdminAnalytics_tmp_stream << stats["total_orders"].asString(); %></p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-1 space-y-4">
                    <h3 class="text-xs font-black text-slate-800 uppercase tracking-widest">Top Sotuvlar</h3>
                    <div class="card p-6 space-y-4">
                        <%c++
                            auto &top_sellers = @@.get<std::vector<std::map<std::string, std::string>>>("top_sellers");
                            for(auto &item : top_sellers) {
                        %>
                        <div class="flex justify-between items-center pb-3 border-b border-slate-50 last:border-0 last:pb-0">
                            <span class="text-xs font-bold text-slate-600 truncate max-w-[150px]"><%c++ AdminAnalytics_tmp_stream << item.at("title"); %></span>
                            <span class="text-[10px] font-black bg-amber-50 text-amber-700 px-2 py-1 rounded uppercase tracking-tighter"><%c++ AdminAnalytics_tmp_stream << item.at("sold"); %> sotilgan</span>
                        </div>
                        <%c++ } %>
                    </div>
                </div>

                <div class="lg:col-span-2 space-y-4">
                    <h3 class="text-xs font-black text-slate-800 uppercase tracking-widest">Oxirgi Buyurtmalar</h3>
                    <div class="card overflow-x-auto">
                        <table class="w-full text-left whitespace-nowrap min-w-[500px]">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Mijoz</th>
                                    <th>Summa</th>
                                    <th>Holat</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                <%c++
                                    auto &recent_orders = @@.get<std::vector<std::map<std::string, std::string>>>("recent_orders");
                                    for(auto &order : recent_orders) {
                                %>
                                <tr class="hover:bg-slate-50/50">
                                    <td class="font-bold text-[11px] text-slate-400">#<%c++ AdminAnalytics_tmp_stream << order.at("id"); %></td>
                                    <td class="font-bold text-slate-800"><%c++ AdminAnalytics_tmp_stream << order.at("full_name"); %></td>
                                    <td class="font-black text-amber-700"><%c++ AdminAnalytics_tmp_stream << order.at("total"); %> so'm</td>
                                    <td>
                                        <span class="badge text-[9px] font-black uppercase py-1 px-2 rounded bg-slate-100 text-slate-500">
                                            <%c++ AdminAnalytics_tmp_stream << order.at("status"); %>
                                        </span>
                                    </td>
                                </tr>
                                <%c++ } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
