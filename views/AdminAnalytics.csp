<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <title>CyberShop Admin Analytics</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Outfit', sans-serif; background-color: #0f172a; color: #f8fafc; } .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }</style>
</head>
<body class="flex h-screen overflow-hidden">
    <div class="w-72 glass shadow-2xl flex flex-col z-20 border-r border-slate-700/50">
        <div class="p-8 border-b border-slate-800">
            <h2 class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500">CyberAdmin</h2>
        </div>
        <nav class="flex-grow p-4 space-y-2">
            <a href="/admin/dashboard" class="block py-3 px-6 text-slate-400 hover:text-white hover:bg-slate-800/50 rounded-xl transition">Mahsulotlar</a>
            <a href="/admin/analytics" class="block py-3 px-6 bg-slate-800/50 text-cyan-400 border border-slate-700 rounded-xl font-bold shadow-[0_0_15px_rgba(34,211,238,0.1)]">Analitika</a>
            <a href="/" class="block py-3 px-6 text-slate-400 hover:text-white hover:bg-slate-800/50 rounded-xl transition">Do'konni ko'rish</a>
        </nav>
    </div>

    <main class="flex-1 p-10 overflow-y-auto relative bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-[#0f172a] to-[#0f172a]">
        <h1 class="text-4xl font-black text-white mb-10">Biznes Analitika</h1>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
            <div class="glass p-8 rounded-3xl border border-slate-700/50 relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-10">
                    <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20"><path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path></svg>
                </div>
                <h3 class="text-slate-400 font-bold uppercase tracking-wider text-sm mb-2">Foydalanuvchilar</h3>
                <p class="text-5xl font-black text-white">Mock: 25</p>
            </div>
            <div class="glass p-8 rounded-3xl border border-slate-700/50 relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-10">
                    <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd"></path></svg>
                </div>
                <h3 class="text-slate-400 font-bold uppercase tracking-wider text-sm mb-2">Sotishlar soni</h3>
                <p class="text-5xl font-black text-white">Mock: 10</p>
            </div>
            <div class="glass p-8 rounded-3xl border border-slate-700/50 relative overflow-hidden bg-gradient-to-br from-cyan-900/30 to-fuchsia-900/30">
                <div class="absolute top-0 right-0 p-4 opacity-10">
                    <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"></path><path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"></path></svg>
                </div>
                <h3 class="text-cyan-400 font-bold uppercase tracking-wider text-sm mb-2">Jami Foyda</h3>
                <p class="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-400">$Mock: 1540.00</p>
            </div>
        </div>

        <div class="glass p-8 rounded-3xl border border-slate-700/50 mt-10 text-center">
            <h3 class="text-xl font-bold text-slate-300 mb-4">Grafiklar kutilmoqda...</h3>
            <p class="text-slate-500">To'liq Chart.js integratsiyasi va API marshrutlari keyingi bosqichda qo'shiladi.</p>
        </div>
    </main>
</body>
</html>
