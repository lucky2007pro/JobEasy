<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <title>CyberShop | Mening Buyurtmalarim</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Outfit', sans-serif; background-color: #0f172a; color: #f8fafc; } .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }</style>
</head>
<body class="min-h-screen flex flex-col">
    <%c++
        using OrderItem = std::map<std::string, std::string>;
        auto &orders = @@.get<std::vector<OrderItem>>("orders");
        auto &name = @@.get<std::string>("user_name");
    %>
    
    <nav class="glass sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <a href="/" class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500">CyberShop</a>
            <div class="flex items-center space-x-4"><a href="/" class="text-slate-300 hover:text-white transition">Bosh sahifa</a></div>
        </div>
    </nav>

    <main class="max-w-5xl mx-auto py-12 px-6 w-full flex-grow">
        <h1 class="text-4xl font-black mb-10 border-l-4 border-fuchsia-500 pl-4 shadow-fuchsia-500/20 text-transparent bg-clip-text bg-gradient-to-r from-white to-fuchsia-200">Mening Buyurtmalarim</h1>
        
        <%c++ if (orders.empty()) { %>
            <div class="glass rounded-3xl p-16 text-center border-dashed border-2 border-slate-700">
                <p class="text-2xl text-slate-500 mb-6 font-light">Siz hali hech narsa xarid qilmadingiz.</p>
                <a href="/" class="inline-block bg-slate-800 text-cyan-400 px-8 py-3 rounded-xl font-bold hover:bg-slate-700 transition">Katalogga o'tish</a>
            </div>
        <%c++ } else { %>
            <div class="grid gap-6">
                <%c++ for(auto &order : orders) { %>
                    <div class="glass rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between shadow-lg relative overflow-hidden group">
                        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-transparent to-cyan-900/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex flex-col gap-2 relative z-10 w-full md:w-auto mb-4 md:mb-0">
                            <div class="flex items-center gap-4">
                                <span class="bg-slate-800 border border-slate-600 text-slate-300 px-3 py-1 rounded-lg text-sm font-mono">Buyurtma #<%c++ Orders_tmp_stream << order.at("id"); %></span>
                                <%c++ if (order.at("status") == "Pending") { %>
                                    <span class="bg-yellow-500/20 text-yellow-400 border border-yellow-500/30 px-3 py-1 rounded-full text-sm font-bold flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>Kutilmoqda</span>
                                <%c++ } else { %>
                                    <span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-3 py-1 rounded-full text-sm font-bold flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-emerald-400"></span><%c++ Orders_tmp_stream << order.at("status"); %></span>
                                <%c++ } %>
                            </div>
                            <span class="text-slate-500 text-sm mt-1">Sana: <%c++ Orders_tmp_stream << order.at("created_at"); %></span>
                        </div>
                        
                        <div class="relative z-10 text-right w-full md:w-auto">
                            <p class="text-slate-400 text-sm font-medium mb-1">To'lov miqdori</p>
                            <p class="text-3xl font-black text-white">$<%c++ Orders_tmp_stream << order.at("total_price"); %></p>
                        </div>
                    </div>
                <%c++ } %>
            </div>
        <%c++ } %>
    </main>
</body>
</html>
