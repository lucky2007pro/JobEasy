<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop | Rasmiylashtirish</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style> 
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .glass-header { background: rgba(255, 255, 255, 0.82); backdrop-filter: blur(16px); border-bottom: 1px solid #e2e8f0; }
        .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; position: relative; z-index: 1; }
        .input-field { background: #fdfdfd; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 14px; width: 100%; outline: none; transition: all 0.2s; font-size: 13px; font-weight: 500; }
        .input-field:focus { border-color: #b45309; background: #ffffff; }
        .btn-amber { background: #b45309; color: white; border-radius: 6px; font-weight: 700; transition: all 0.2s; }
        .btn-amber:hover { background: #92400e; }
        .step-num { width: 22px; height: 22px; display: flex; items-center; justify-center; background: #b45309; color: white; border-radius: 6px; font-size: 10px; font-weight: 900; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <%c++
        using ItemMap = std::map<std::string, std::string>;
        auto &items = @@.get<std::vector<ItemMap>>("items");
        auto subtotal = @@.get<double>("subtotal");
        auto delivery_fee = @@.get<double>("delivery_fee");
        auto grand_total = @@.get<double>("grand_total");
        auto csrf_token = @@.get<std::string>("csrf_token");
        auto user_name = @@.get<std::string>("user_name");
        auto user_balance = @@.get<double>("user_balance");
    %>
    
    <header class="glass-header sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 md:px-8 py-3 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2">
                <div class="w-6 h-6 bg-amber-700 rounded-lg flex items-center justify-center text-white font-black text-[10px]">C</div>
                <span class="text-base font-bold text-slate-800 tracking-tight">CyberShop</span>
            </a>
            <div class="flex items-center gap-4 text-[9px] font-black text-slate-400 uppercase tracking-widest">
                <span class="text-amber-700">SAVAT</span>
                <span class="opacity-30">/</span>
                <span class="text-slate-800">TO'LOV</span>
                <span class="opacity-30">/</span>
                <span class="opacity-50">YAKUNLASH</span>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto px-4 md:px-8 py-10 w-full space-y-8">
        <div class="space-y-1">
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Buyurtma Rasmiylashtirish</h1>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none">Oxirgi qadam va tasdiqlash</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            <div class="lg:col-span-2 space-y-6">
                <div class="card p-6 md:p-8 space-y-8">
                    <div class="flex items-center gap-3">
                        <div class="step-num shadow-lg shadow-amber-900/20">1</div>
                        <h2 class="text-[11px] font-black text-slate-800 uppercase tracking-widest">YETKAZIB BERISH MA'LUMOTLARI</h2>
                    </div>
                    
                    <form id="checkout-form" action="/checkout" method="POST" class="space-y-5">
                        <input type="hidden" name="csrf_token" value="<%c++ Checkout_tmp_stream << csrf_token; %>">
                        <input type="hidden" name="payment_method" value="wallet">
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Qabul qiluvchi</label>
                                <input type="text" name="full_name" value="<%c++ Checkout_tmp_stream << user_name; %>" class="input-field" placeholder="Ism-sharifingiz">
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Telefon raqam</label>
                                <input type="text" name="phone" placeholder="+998 90 123 45 67" required class="input-field">
                            </div>
                        </div>
                        
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Manzil xaritasi (Ko'cha/Uy/Yurish)</label>
                            <textarea name="address" rows="3" placeholder="Toshkent shahri, Chilonzor tumani, 10-mavze, 5-uy" required class="input-field" style="resize: vertical; min-height: 60px;"></textarea>
                        </div>
                    </form>
                </div>

                <div class="card p-6 md:p-8 space-y-6">
                    <div class="flex items-center gap-3">
                        <div class="step-num shadow-lg shadow-amber-900/20">2</div>
                        <h2 class="text-[11px] font-black text-slate-800 uppercase tracking-widest">YETKAZIB BERISH TURI</h2>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <label class="relative cursor-pointer group">
                            <input type="radio" name="delivery_type" value="standard" checked class="peer absolute opacity-0" form="checkout-form" onclick="updateDeliveryFee('standard')">
                            <div class="p-4 border border-slate-100 rounded-lg bg-slate-50 peer-checked:border-amber-700 peer-checked:bg-amber-50/20 transition-all border-dashed">
                                <p class="text-[11px] font-black text-slate-800 uppercase tracking-tight">STANDART YETKAZISH</p>
                                <p class="text-[9px] text-slate-400 font-bold uppercase tracking-widest mt-1 opacity-70">1-3 KUN, 18 000 so'm</p>
                            </div>
                        </label>
                        <label class="relative cursor-pointer group">
                            <input type="radio" name="delivery_type" value="express" class="peer absolute opacity-0" form="checkout-form" onclick="updateDeliveryFee('express')">
                            <div class="p-4 border border-slate-100 rounded-lg bg-slate-50 peer-checked:border-amber-700 peer-checked:bg-amber-50/20 transition-all border-dashed">
                                <p class="text-[11px] font-black text-slate-800 uppercase tracking-tight">TEZKOR YETKAZISH</p>
                                <p class="text-[9px] text-slate-400 font-bold uppercase tracking-widest mt-1 opacity-70">24 SOAT, 35 000 so'm</p>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="card p-6 md:p-8 space-y-6">
                    <div class="flex items-center gap-3">
                        <div class="step-num shadow-lg shadow-amber-900/20">3</div>
                        <h2 class="text-[11px] font-black text-slate-800 uppercase tracking-widest">TO'LOV USULI</h2>
                    </div>
                    <div class="p-4 border-2 border-amber-700 rounded-lg bg-amber-50/30">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-900 to-violet-700 flex items-center justify-center text-white font-black text-sm">₩</div>
                                <div>
                                    <p class="text-[11px] font-black text-slate-800 uppercase tracking-tight">HAMYON ORQALI TO'LOV</p>
                                    <p class="text-[9px] text-slate-400 font-bold uppercase tracking-widest mt-0.5">Balans hisobidan yechiladi</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-lg font-extrabold <%c++ Checkout_tmp_stream << (user_balance >= grand_total ? "text-emerald-600" : "text-red-500"); %>"><%c++ Checkout_tmp_stream << std::fixed << std::setprecision(0) << user_balance; %> so'm</p>
                                <p class="text-[8px] font-black uppercase tracking-widest <%c++ Checkout_tmp_stream << (user_balance >= grand_total ? "text-emerald-500" : "text-red-400"); %>"><%c++ Checkout_tmp_stream << (user_balance >= grand_total ? "YETARLI" : "YETARLI EMAS"); %></p>
                            </div>
                        </div>
                    </div>
                    <%c++ if (user_balance < grand_total) { %>
                        <a href="/wallet" class="block text-center text-[10px] font-bold text-violet-700 hover:text-violet-900 transition-colors py-2">→ Hamyonni to'ldirish</a>
                    <%c++ } %>
                </div>
            </div>

            <div class="lg:w-full">
                <div class="card p-6 bg-slate-900 border-slate-900 shadow-2xl shadow-slate-200 sticky top-24">
                    <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-500 mb-6 flex items-center gap-2">
                        <span class="w-1 h-3 bg-amber-500 rounded-full"></span>
                        BUYURTMA XULOSASI
                    </h3>
                    
                    <div class="space-y-3 max-h-48 overflow-y-auto pr-2 scrollbar-thin scrollbar-thumb-slate-800 mb-6">
                        <%c++ for(auto &item : items) { %>
                            <div class="flex gap-3 items-center">
                                <div class="w-10 h-10 bg-slate-800 rounded border border-slate-800 p-1 shrink-0">
                                    <img src="<%c++ Checkout_tmp_stream << item.at("image_url"); %>" class="w-full h-full object-contain mix-blend-lighten">
                                </div>
                                <div class="min-w-0 flex-grow">
                                    <h4 class="text-[10px] font-bold text-slate-300 truncate tracking-tight"><%c++ Checkout_tmp_stream << item.at("title"); %></h4>
                                    <p class="text-[9px] font-black text-amber-500 uppercase tracking-wider opacity-80"><%c++ Checkout_tmp_stream << item.at("quantity"); %> × <%c++ Checkout_tmp_stream << item.at("price"); %> so'm</p>
                                </div>
                            </div>
                        <%c++ } %>
                    </div>

                    <div class="space-y-3 pt-5 border-t border-slate-800">
                        <div class="flex justify-between items-center text-[10px] font-black text-slate-500 uppercase tracking-widest">
                            <span>SUMMA:</span>
                            <span class="text-slate-200 tracking-widest"><%c++ Checkout_tmp_stream << std::fixed << std::setprecision(2) << subtotal; %> so'm</span>
                        </div>
                        <div class="flex justify-between items-center text-[10px] font-black text-slate-500 uppercase tracking-widest">
                            <span>YETKAZIB BERISH:</span>
                            <span id="deliveryFeeText" class="text-emerald-500 uppercase"><%c++ Checkout_tmp_stream << std::fixed << std::setprecision(2) << delivery_fee; %> so'm</span>
                        </div>
                        <div class="flex justify-between items-end pt-5 mt-5 border-t border-slate-800">
                            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">JAMI TO'LOV:</span>
                            <span id="grandTotalText" class="text-2xl font-black text-white tracking-tighter"><%c++ Checkout_tmp_stream << std::fixed << std::setprecision(2) << grand_total; %> so'm</span>
                        </div>
                    </div>

                    <button form="checkout-form" class="w-full btn-amber py-3.5 text-[10px] uppercase tracking-widest shadow-xl shadow-amber-900/40 mt-8 mb-4">BUYURTMANI TASDIQLASH</button>
                    <a href="/cart" class="block text-center text-[9px] font-black text-slate-600 hover:text-amber-500 uppercase tracking-widest transition-colors">← SAVATGA QAYTISH</a>
                </div>
            </div>
        </div>
    </main>

    <footer class="mt-auto py-8 text-center bg-white border-t border-slate-100">
        <p class="text-[9px] font-black text-slate-300 uppercase tracking-[0.2em]">© 2026 CYBERSHOP &middot; SECURE CHECKOUT</p>
    </footer>
    <script>
        const subtotal = parseFloat("<%c++ Checkout_tmp_stream << std::fixed << std::setprecision(2) << subtotal; %>");
        function updateDeliveryFee(type) {
            let fee = 18000;
            if (type === 'express') fee = 35000;
            if (subtotal >= 500000) fee = 0;
            const total = subtotal + fee;
            document.getElementById('deliveryFeeText').textContent = fee.toFixed(2) + " so'm";
            document.getElementById('grandTotalText').textContent = total.toFixed(2) + " so'm";
        }
    </script>
</body>
</html>
