<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop | Hamyon</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background: #f8fafc; color: #0f172a; }
        .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 18px; }
        .hero { background: linear-gradient(135deg, #0f172a, #312e81 60%, #7c3aed); }
        .soft { color: #64748b; }
        .btn-main { background: #b45309; color: #fff; border-radius: 12px; font-weight: 700; }
        .btn-main:hover { background: #92400e; }
        .field { width: 100%; border: 1px solid #dbe3ef; border-radius: 12px; padding: 12px 14px; outline: none; }
        .field:focus { border-color: #7c3aed; box-shadow: 0 0 0 4px rgba(124,58,237,0.08); }
    </style>
</head>
<body class="min-h-screen">
    <%c++
        using WalletItem = std::map<std::string, std::string>;
        auto balance = @@.get<std::string>("balance");
        auto userName = @@.get<std::string>("user_name");
        auto csrf = @@.get<std::string>("csrf_token");
        auto &cards = @@.get<std::vector<WalletItem>>("cards");
        auto &transactions = @@.get<std::vector<WalletItem>>("transactions");
    %>
    <div class="max-w-7xl mx-auto px-4 md:px-8 py-10 space-y-8">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-[11px] font-black uppercase tracking-[0.25em] text-slate-400">Moliya markazi</p>
                <h1 class="text-3xl font-extrabold tracking-tight mt-2">Hamyon</h1>
            </div>
            <a href="/" class="text-sm font-bold text-amber-700 hover:text-amber-800">Asosiyga qaytish</a>
        </div>

        <div class="grid lg:grid-cols-3 gap-6">
            <div class="lg:col-span-1 space-y-6">
                <div class="hero rounded-[22px] text-white p-7 shadow-2xl shadow-indigo-900/15">
                    <p class="text-xs font-black uppercase tracking-[0.28em] text-indigo-200">Hisob egasi</p>
                    <h2 class="text-xl font-bold mt-3"><%c++ Wallet_tmp_stream << userName; %></h2>
                    <p class="text-xs text-indigo-100/80 mt-6">Joriy balans</p>
                    <div class="text-4xl font-black tracking-tight mt-2"><%c++ Wallet_tmp_stream << balance; %> <span class="text-lg font-medium">so'm</span></div>
                </div>

                <div class="card p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold">Kartalar</h3>
                        <a href="/wallet/add-card" class="text-sm font-bold text-violet-700">+ Karta qo'shish</a>
                    </div>
                    <div class="space-y-3">
                        <%c++ if (cards.empty()) { %>
                            <div class="rounded-2xl border border-dashed border-slate-200 p-6 text-center soft">Hozircha kartalar yo'q</div>
                        <%c++ } else { %>
                            <%c++ for (auto &card : cards) { %>
                                <div class="rounded-2xl border border-slate-200 px-4 py-4">
                                    <div class="flex items-center justify-between gap-3">
                                        <div>
                                            <p class="text-sm font-black text-slate-800 uppercase"><%c++ Wallet_tmp_stream << card.at("provider"); %></p>
                                            <p class="text-base font-bold mt-1"><%c++ Wallet_tmp_stream << card.at("number"); %></p>
                                            <p class="text-xs soft mt-1"><%c++ Wallet_tmp_stream << card.at("holder"); %></p>
                                        </div>
                                    </div>
                                </div>
                            <%c++ } %>
                        <%c++ } %>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-6">
                <div class="card p-6">
                    <div class="flex items-center justify-between mb-5">
                        <div>
                            <p class="text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Balansni to'ldirish</p>
                            <h3 class="text-xl font-bold mt-2">Tezkor to'lov</h3>
                        </div>
                    </div>
                    <form action="/wallet/topup" method="POST" class="grid md:grid-cols-3 gap-4 items-end">
                        <input type="hidden" name="csrf_token" value="<%c++ Wallet_tmp_stream << csrf; %>">
                        <div class="md:col-span-1">
                            <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-2">Karta</label>
                            <select name="card_id" class="field" required>
                                <%c++ for (auto &card : cards) { %>
                                    <option value="<%c++ Wallet_tmp_stream << card.at("id"); %>"><%c++ Wallet_tmp_stream << card.at("number"); %></option>
                                <%c++ } %>
                            </select>
                        </div>
                        <div class="md:col-span-1">
                            <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-2">Summa</label>
                            <input type="number" name="amount" min="1000" class="field" placeholder="50000" required>
                        </div>
                        <div class="md:col-span-1">
                            <button type="submit" class="btn-main w-full py-3">To'ldirish</button>
                        </div>
                    </form>
                </div>

                <div class="card p-6">
                    <div class="flex items-center justify-between mb-5">
                        <div>
                            <p class="text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Tarix</p>
                            <h3 class="text-xl font-bold mt-2">Oxirgi tranzaksiyalar</h3>
                        </div>
                    </div>
                    <div class="space-y-3">
                        <%c++ if (transactions.empty()) { %>
                            <div class="rounded-2xl border border-dashed border-slate-200 p-6 text-center soft">Hozircha o'tkazmalar mavjud emas</div>
                        <%c++ } else { %>
                            <%c++ for (auto &tx : transactions) { %>
                                <div class="rounded-2xl border border-slate-200 px-4 py-4 flex items-center justify-between gap-4 hover:border-slate-300 transition-colors">
                                    <div class="flex items-center gap-3">
                                        <%c++ if (tx.at("type") == "top-up") { %>
                                            <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-500 text-lg font-black shrink-0">↑</div>
                                        <%c++ } else if (tx.at("type") == "refund") { %>
                                            <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-500 text-lg font-black shrink-0">↩</div>
                                        <%c++ } else { %>
                                            <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center text-red-500 text-lg font-black shrink-0">↓</div>
                                        <%c++ } %>
                                        <div>
                                            <p class="font-bold text-slate-800 text-sm"><%c++ Wallet_tmp_stream << tx.at("description"); %></p>
                                            <p class="text-xs soft mt-0.5"><%c++ Wallet_tmp_stream << tx.at("created_at"); %></p>
                                        </div>
                                    </div>
                                    <div class="text-right shrink-0">
                                        <p class="font-black text-base <%c++ Wallet_tmp_stream << (tx.at("type") == "payment" ? "text-red-500" : (tx.at("type") == "refund" ? "text-blue-600" : "text-emerald-600")); %>">
                                            <%c++ Wallet_tmp_stream << (tx.at("type") == "top-up" || tx.at("type") == "refund" ? "+" : "-"); %><%c++ Wallet_tmp_stream << tx.at("amount"); %> so'm
                                        </p>
                                        <p class="text-[9px] uppercase tracking-widest font-bold mt-0.5 <%c++ Wallet_tmp_stream << (tx.at("type") == "payment" ? "text-red-400" : (tx.at("type") == "refund" ? "text-blue-400" : "text-emerald-400")); %>">
                                            <%c++ Wallet_tmp_stream << (tx.at("type") == "top-up" ? "TO'LDIRILDI" : (tx.at("type") == "refund" ? "QAYTARILDI" : "SARFLANDI")); %>
                                        </p>
                                    </div>
                                </div>
                            <%c++ } %>
                        <%c++ } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
