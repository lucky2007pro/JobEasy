<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop | Kirish</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style> 
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; }
        .input-field { background: #fdfdfd; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 14px; width: 100%; outline: none; transition: all 0.2s; font-size: 13px; font-weight: 500; }
        .input-field:focus { border-color: #b45309; background: #ffffff; }
        .btn-amber { background: #b45309; color: white; border-radius: 6px; font-weight: 700; transition: all 0.2s; }
        .btn-amber:hover { background: #92400e; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <%c++
        auto csrf = @@.get<std::string>("csrf_token");
        auto errorMsg = @@.get<std::string>("error_msg");
    %>
    <div class="flex-grow flex flex-col items-center justify-center p-6 bg-slate-50/50">
        <a href="/" class="flex items-center gap-2 mb-10 group">
            <div class="w-7 h-7 bg-amber-700 rounded-lg flex items-center justify-center text-white font-black text-[11px] shadow-lg shadow-amber-900/20 group-hover:scale-110 transition duration-300">C</div>
            <span class="text-lg font-bold text-slate-800 tracking-tight">CyberShop</span>
        </a>

        <div class="card p-8 md:p-10 w-full max-w-sm space-y-8 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-amber-700/10"></div>
            
            <div class="text-center space-y-1">
                <h1 class="text-xl font-bold text-slate-800 tracking-tight">Xush kelibsiz</h1>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none">Hisobingizga kiring</p>
            </div>

            <%c++ if (!errorMsg.empty()) { %>
            <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg flex items-center gap-2">
                <span>⚠</span> <%c++ Login_tmp_stream << errorMsg; %>
            </div>
            <%c++ } %>

            <form action="/login" method="POST" class="space-y-5">
                <input type="hidden" name="csrf_token" value="<%c++ Login_tmp_stream << csrf; %>">
                <div class="space-y-1.5">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Elektron Pochta</label>
                    <input type="email" name="email" placeholder="mail@example.com" required class="input-field">
                </div>
                <div class="space-y-1.5">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Maxfiy Parol</label>
                    <input type="password" name="password" placeholder="••••••••" required class="input-field">
                </div>
                <button type="submit" class="btn-amber w-full py-3.5 text-[10px] uppercase tracking-widest shadow-xl shadow-amber-900/10 mt-2">KIRISH</button>
            </form>

            <div class="pt-6 border-t border-slate-50 text-center">
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-tight">
                    Hisobingiz yo'qmi? 
                    <a href="/register" class="text-amber-700 hover:text-amber-800 ml-1">RO'YXATDAN O'TISH</a>
                </p>
            </div>
        </div>

        <div class="mt-12 flex items-center gap-4 text-slate-200">
            <span class="w-12 h-px bg-slate-200"></span>
            <span class="text-[8px] font-black tracking-[0.3em] uppercase">Security Shield 2.0</span>
            <span class="w-12 h-px bg-slate-200"></span>
        </div>
    </div>

    <footer class="py-8 text-center">
        <p class="text-[9px] font-black text-slate-300 uppercase tracking-[0.2em]">© 2026 CYBERSHOP &middot; ECO-SYSTEM</p>
    </footer>
</body>
</html>