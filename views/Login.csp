<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Outfit', sans-serif; background-color: #0f172a; color: #f8fafc; } .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }</style>
    <title>Login | CyberShop</title>
</head>
<body class="min-h-screen flex items-center justify-center relative bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-cyan-900/20 via-[#0f172a] to-[#0f172a]">
    <div class="glass p-10 rounded-3xl shadow-2xl w-full max-w-md border border-slate-700/50 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-cyan-400 to-fuchsia-500"></div>
        <div class="text-center mb-8">
            <a href="/" class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500 pb-2">CyberShop</a>
            <p class="text-slate-400 mt-2">Tizimga kirish</p>
        </div>

        <form action="/api/login" method="POST" class="space-y-6">
            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Email manzil</label>
                <input type="email" name="email" required 
                       class="w-full p-4 bg-slate-900/50 border border-slate-700 rounded-2xl focus:ring-2 focus:ring-cyan-500 outline-none text-white transition">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Parol</label>
                <input type="password" name="password" required 
                       class="w-full p-4 bg-slate-900/50 border border-slate-700 rounded-2xl focus:ring-2 focus:ring-cyan-500 outline-none text-white transition">
            </div>
            <button type="submit" 
                    class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-black py-4 rounded-2xl hover:shadow-[0_0_20px_rgba(34,211,238,0.5)] transition-all">
                Kirish
            </button>
        </form>
        
        <p class="mt-8 text-center text-sm text-slate-500">
            Hisobingiz yo'qmi? <a href="/api/register" class="text-cyan-400 font-bold hover:underline">Ro'yxatdan o'ting</a>
        </p>
    </div>
</body>
</html>