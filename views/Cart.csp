<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop | Savat</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style> 
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .glass-header { background: rgba(255, 255, 255, 0.82); backdrop-filter: blur(16px); border-bottom: 1px solid #e2e8f0; }
        .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; }
        .btn-amber { background: #b45309; color: white; border-radius: 7px; font-weight: 700; transition: all 0.2s; }
        .btn-amber:hover { background: #92400e; }
        .item-row { transition: background 0.2s; }
        .item-row:hover { background: #f8fafc; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <%c++
        using CartItem = std::map<std::string, std::string>;
        auto &items = @@.get<std::vector<CartItem>>("cart_items");
        auto total_price = @@.get<std::string>("total_price");
        auto &name = @@.get<std::string>("user_name");
        auto is_logged_in = @@.get<bool>("is_logged_in");
    %>
    
    <header class="glass-header sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 md:px-8 py-3 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2">
                <div class="w-6 h-6 bg-amber-700 rounded-lg flex items-center justify-center text-white font-black text-[10px]">C</div>
                <span class="text-base font-bold text-slate-800 tracking-tight">CyberShop</span>
            </a>
            <div class="flex items-center gap-5">
                <a href="/" class="text-[10px] font-black text-slate-400 hover:text-amber-700 uppercase tracking-widest">DO'KON</a>
                <a href="/wishlist" class="text-[10px] font-black text-slate-400 hover:text-amber-700 uppercase tracking-widest">SEVIMLI</a>
                <div class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-[9px] font-black text-slate-600 border border-slate-200">
                    <%c++ Cart_tmp_stream << (name.empty() ? "?" : name.substr(0,1)); %>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto px-4 md:px-8 py-10 w-full space-y-8">
        <div class="space-y-1">
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Sizning Savatingiz</h1>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none">Mahsulotlarni tekshiring va rasmiylashtiring</p>
        </div>

        <%c++ if (items.empty()) { %>
            <div class="card p-16 text-center space-y-4 border-dashed bg-slate-50/20">
                <div class="text-4xl opacity-20">🛒</div>
                <h2 class="text-lg font-bold text-slate-800">Savat hozircha bo'sh</h2>
                <p class="text-xs text-slate-400 font-medium max-w-xs mx-auto">Hech qanday mahsulot qo'shilmadi. Do'kon bo'limidan mahsulot tanlang.</p>
                <a href="/" class="inline-block btn-amber px-8 py-2.5 text-[10px] uppercase tracking-widest mt-2 shadow-xl shadow-amber-900/10">Xaridni boshlash</a>
            </div>
        <%c++ } else { %>
            <div class="flex flex-col lg:flex-row gap-8 items-start">
                <div class="lg:w-2/3 w-full">
                    <div class="card overflow-hidden">
                        <div class="bg-slate-50 px-6 py-2.5 border-b border-slate-100 flex justify-between text-[9px] font-black text-slate-400 uppercase tracking-widest">
                            <span>Tanlangan mahsulotlar</span>
                            <span>Summa</span>
                        </div>
                        <div class="divide-y divide-slate-50">
                            <%c++ for(auto &item : items) { %>
                                <div class="item-row p-5 flex items-center justify-between gap-4">
                                    <div class="flex items-center gap-4 flex-grow">
                                        <div class="w-14 h-14 bg-white rounded border border-slate-100 flex items-center justify-center p-2 shrink-0">
                                            <%c++ if (!item.at("image_url").empty()) { %>
                                                <img src="<%c++ Cart_tmp_stream << item.at("image_url"); %>" class="max-h-full object-contain">
                                            <%c++ } else { %> <span class="text-xl">📦</span> <%c++ } %>
                                        </div>
                                        <div class="min-w-0">
                                            <h3 class="text-xs font-bold text-slate-800 truncate"><%c++ Cart_tmp_stream << item.at("title"); %></h3>
                                            <p class="text-[10px] font-black text-amber-700 mt-0.5">$<%c++ Cart_tmp_stream << item.at("price"); %> <span class="text-slate-300 mx-1">×</span> <%c++ Cart_tmp_stream << item.at("quantity"); %></p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-6 shrink-0">
                                        <div class="text-right">
                                            <p class="text-xs font-black text-slate-900">$<%c++ Cart_tmp_stream << item.at("subtotal"); %></p>
                                        </div>
                                        <form action="/cart/remove/<%c++ Cart_tmp_stream << item.at("cart_id"); %>" method="POST">
                                            <input type="hidden" name="csrf_token" value="<%c++ Cart_tmp_stream << @@.get<std::string>("csrf_token"); %>">
                                            <button class="w-7 h-7 flex items-center justify-center text-slate-200 hover:text-red-500 hover:bg-red-50 rounded transition-all">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            <%c++ } %>
                        </div>
                    </div>
                    <a href="/" class="inline-block mt-4 text-[10px] font-black text-amber-700 uppercase tracking-widest hover:translate-x-1 transition-transform">← Tanlashda davom etish</a>
                </div>

                <div class="lg:w-1/3 w-full sticky top-24">
                    <div class="card p-6 bg-slate-900 border-slate-900 shadow-2xl shadow-slate-200">
                        <h2 class="text-[10px] font-black uppercase tracking-widest text-slate-500 mb-6 flex items-center gap-2">
                            <span class="w-1 h-3 bg-amber-500 rounded-full"></span>
                            HISOB-KITOBLAR
                        </h2>
                        <div class="space-y-4">
                            <div class="flex justify-between items-center text-[11px] font-bold">
                                <span class="text-slate-400 uppercase tracking-tight">KAYTA HISOLAH:</span>
                                <span class="text-white tracking-widest">$<%c++ Cart_tmp_stream << total_price; %></span>
                            </div>
                            <div class="flex justify-between items-center text-[11px] font-bold">
                                <span class="text-slate-400 uppercase tracking-tight">YETKAZIB BERISH:</span>
                                <span class="text-emerald-400 uppercase tracking-widest">BEPUL</span>
                            </div>
                            <div class="pt-5 mt-5 border-t border-slate-800 flex justify-between items-end">
                                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">JAMI SUMMA:</span>
                                <span class="text-2xl font-black text-white tracking-tighter">$<%c++ Cart_tmp_stream << total_price; %></span>
                            </div>
                        </div>
                        
                        <form action="/order/checkout" method="POST" class="mt-8">
                            <input type="hidden" name="csrf_token" value="<%c++ Cart_tmp_stream << @@.get<std::string>("csrf_token"); %>">
                            <button class="w-full btn-amber py-3.5 text-[10px] uppercase tracking-widest shadow-xl shadow-amber-900/40">TO'LOVGA O'TISH</button>
                        </form>
                        
                        <p class="text-center text-[8px] font-black text-slate-600 uppercase tracking-widest mt-6">🔒 256-BIT SSL XAVFSIZ TO'LOV</p>
                    </div>
                </div>
            </div>
        <%c++ } %>
    </main>

    <footer class="mt-auto py-8 text-center bg-white border-t border-slate-100">
        <p class="text-[9px] font-black text-slate-300 uppercase tracking-[0.2em]">© 2026 CYBERSHOP &middot; DROGON BACKEND</p>
    </footer>
</body>
</html>
