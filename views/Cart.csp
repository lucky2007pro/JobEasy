<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <title>CyberShop | Savatcha</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Outfit', sans-serif; background-color: #0f172a; color: #f8fafc; } .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }</style>
</head>
<body class="min-h-screen flex flex-col">
    <%c++
        using CartItem = std::map<std::string, std::string>;
        auto &items = @@.get<std::vector<CartItem>>("cart_items");
        auto total_price = @@.get<std::string>("total_price");
        auto &name = @@.get<std::string>("user_name");
    %>
    
    <nav class="glass sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <a href="/" class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500">CyberShop</a>
            <div class="flex items-center space-x-4"><span class="text-slate-300">Savatchangiz</span></div>
        </div>
    </nav>

    <main class="max-w-5xl mx-auto py-12 px-6 w-full flex-grow">
        <h1 class="text-4xl font-black mb-10 flex items-center gap-3"><span class="text-cyan-400">🛒</span> Sizning savatchangiz</h1>
        
        <%c++ if (items.empty()) { %>
            <div class="glass rounded-3xl p-16 text-center border-dashed border-2 border-slate-700">
                <p class="text-2xl text-slate-500 mb-6 font-light">Savatchangiz bo'm-bo'sh, xaridni boshlang!</p>
                <a href="/" class="inline-block bg-slate-800 text-cyan-400 px-8 py-3 rounded-xl font-bold hover:bg-slate-700 transition border border-slate-600">Bosh sahifaga</a>
            </div>
        <%c++ } else { %>
            <div class="flex flex-col lg:flex-row gap-8">
                <div class="lg:w-2/3 space-y-4">
                    <%c++ for(auto &item : items) { %>
                        <div class="glass rounded-2xl p-4 flex items-center justify-between shadow-lg">
                            <div class="flex items-center gap-6">
                                <div class="w-24 h-24 bg-slate-900 rounded-xl flex items-center justify-center p-2 border border-slate-700">
                                    <%c++ if (!item.at("image_url").empty()) { %>
                                        <img src="<%c++ Cart_tmp_stream << item.at("image_url"); %>" class="max-h-full object-contain">
                                    <%c++ } else { %> <span class="text-3xl">📦</span> <%c++ } %>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold"><%c++ Cart_tmp_stream << item.at("title"); %></h3>
                                    <p class="text-fuchsia-400 font-bold">$<%c++ Cart_tmp_stream << item.at("price"); %> x <%c++ Cart_tmp_stream << item.at("quantity"); %></p>
                                </div>
                            </div>
                            <div class="flex items-center gap-6">
                                <p class="text-2xl font-black text-cyan-300">$<%c++ Cart_tmp_stream << item.at("subtotal"); %></p>
                                <a href="/cart/remove/<%c++ Cart_tmp_stream << item.at("cart_id"); %>" class="w-10 h-10 bg-red-500/20 text-red-400 rounded-full flex items-center justify-center hover:bg-red-500 hover:text-white transition group border border-red-500/30">
                                    <svg xmlns="http://www.w3.org/w/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                </a>
                            </div>
                        </div>
                    <%c++ } %>
                </div>
                
                <div class="lg:w-1/3">
                    <div class="glass rounded-3xl p-8 sticky top-28 border border-cyan-900/50 shadow-[0_0_30px_rgba(34,211,238,0.1)]">
                        <h2 class="text-2xl font-bold mb-6 border-b border-slate-700 pb-4">Hisobot</h2>
                        <div class="flex justify-between mb-4 text-slate-300"><span>Jami summa:</span> <span class="font-bold text-white">$<%c++ Cart_tmp_stream << total_price; %></span></div>
                        <div class="flex justify-between mb-8 text-slate-300"><span>Yetkazib berish:</span> <span class="text-emerald-400 font-bold">Bepul</span></div>
                        
                        <div class="flex justify-between mb-8 pb-4 border-b border-slate-700">
                            <span class="text-xl">Jami to'lov:</span> 
                            <span class="text-3xl font-black text-cyan-400 text-shadow">$<%c++ Cart_tmp_stream << total_price; %></span>
                        </div>
                        
                        <form action="/order/checkout" method="POST">
                            <button class="w-full bg-gradient-to-r from-fuchsia-600 to-cyan-500 text-white font-black py-4 rounded-xl hover:shadow-[0_0_20px_rgba(192,38,211,0.5)] transition-all transform hover:-translate-y-1">Rasmiylashtirish 🚀</button>
                        </form>
                    </div>
                </div>
            </div>
        <%c++ } %>
    </main>
</body>
</html>
