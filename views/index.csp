<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop | Bosh Sahifa</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style> 
        :root { --bg: #0f172a; --text: #f8fafc; --glass: rgba(255, 255, 255, 0.05); --border: rgba(255, 255, 255, 0.1); }
        .light { --bg: #f8fafc; --text: #0f172a; --glass: rgba(0, 0, 0, 0.05); --border: rgba(0, 0, 0, 0.1); }
        body { font-family: 'Outfit', sans-serif; background-color: var(--bg); color: var(--text); transition: background-color 0.3s, color 0.3s; }
        .glass { background: var(--glass); backdrop-filter: blur(10px); border: 1px solid var(--border); }
    </style>
    <script>
        if (localStorage.theme === 'light' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: light)').matches)) {
            document.documentElement.classList.add('light')
        } else {
            document.documentElement.classList.remove('light')
        }
        function toggleTheme() {
            if (document.documentElement.classList.contains('light')) {
                document.documentElement.classList.remove('light');
                localStorage.theme = 'dark';
            } else {
                document.documentElement.classList.add('light');
                localStorage.theme = 'light';
            }
        }
    </script>
</head>
<body class="min-h-screen flex flex-col">
    <%c++
        using ProductItem = std::map<std::string, std::string>;
        auto &products = @@.get<std::vector<ProductItem>>("products");
        auto &name = @@.get<std::string>("user_name");
        auto is_logged_in = @@.get<bool>("is_logged_in");
    %>
    
    <nav class="glass sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <a href="/" class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500 tracking-tighter">CyberShop</a>
            <div class="flex items-center space-x-6">
                <button onclick="toggleTheme()" class="w-10 h-10 glass rounded-xl flex items-center justify-center hover:scale-110 transition">🌓</button>
                <a href="/" class="text-slate-300 hover:text-cyan-400 font-semibold transition">Bosh sahifa</a>
                <a href="/wishlist" class="text-slate-300 hover:text-cyan-400 font-semibold transition">Sevimlilar ❤️</a>
                <a href="/cart" class="text-slate-300 hover:text-cyan-400 font-semibold transition">Savatcha 🛒</a>
                <%c++ if (is_logged_in) { %>
                    <a href="/orders" class="text-slate-300 hover:text-fuchsia-400 font-semibold transition">Buyurtmalar</a>
                    <div class="glass px-4 py-1.5 rounded-full text-sm">
                        <span>Salom, <b class="text-cyan-400"><%c++ index_tmp_stream << name; %></b></span>
                    </div>
                    <a href="/api/logout" class="bg-red-500/20 hover:bg-red-500/40 text-red-100 px-4 py-2 rounded-xl text-sm font-bold transition">Chiqish</a>
                <%c++ } else { %>
                    <a href="/api/login" class="bg-gradient-to-r from-cyan-500 to-blue-500 text-white px-6 py-2 rounded-xl font-bold hover:shadow-[0_0_15px_rgba(34,211,238,0.5)] transition">Kirish</a>
                <%c++ } %>
            </div>
        </div>
    </nav>

    <main class="flex-grow max-w-7xl mx-auto py-12 px-6 w-full space-y-16">
        <section class="glass rounded-[3rem] p-12 text-center relative overflow-hidden shadow-2xl shadow-cyan-900/20 text-white">
            <div class="absolute inset-0 bg-gradient-to-br from-fuchsia-600/20 via-transparent to-cyan-600/20"></div>
            <h1 class="text-5xl md:text-7xl font-black mb-6 relative z-10 text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-white to-fuchsia-300">Kelajak Texnologiyalari</h1>
            <p class="text-lg md:text-xl text-slate-300 mb-8 relative z-10 max-w-2xl mx-auto">Eng so'nggi gadjetlar va elektronika mahsulotlarini bizning premium platformamizdan xarid qiling.</p>
        </section>

        <section>
            <div class="flex justify-between items-end mb-10 border-b border-slate-800 pb-4">
                <h2 class="text-3xl font-bold flex items-center">
                    <span class="w-3 h-10 bg-cyan-400 rounded-full mr-4 shadow-[0_0_10px_rgba(34,211,238,0.6)]"></span>
                    🔥 Top Mahsulotlar
                </h2>
                <div class="flex gap-4">
                    <select id="sortSelect" onchange="window.location.href='/?sort=' + this.value" class="bg-slate-800 text-slate-300 px-4 py-2 rounded-xl border border-slate-700 outline-none focus:border-cyan-500">
                        <option value="newest">Yangi mahsulotlar</option>
                        <option value="price_asc">Narxi (Arzon-Qimmat)</option>
                        <option value="price_desc">Narxi (Qimmat-Arzon)</option>
                        <option value="oldest">Eski mahsulotlar</option>
                    </select>
                    <script>
                        const urlParams = new URLSearchParams(window.location.search);
                        const sort = urlParams.get('sort');
                        if (sort) document.getElementById('sortSelect').value = sort;
                    </script>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                <%c++ for(auto &p : products) { %>
                    <div class="glass rounded-3xl overflow-hidden group hover:-translate-y-2 hover:shadow-[0_0_25px_rgba(192,38,211,0.2)] transition-all duration-300 flex flex-col">
                        <div class="h-56 bg-slate-800 flex items-center justify-center p-4 relative overflow-hidden">
                            <%c++ if (!p.at("image_url").empty()) { %>
                                <img src="<%c++ index_tmp_stream << p.at("image_url"); %>" alt="Product" class="max-h-full object-contain group-hover:scale-110 transition duration-500">
                            <%c++ } else { %>
                                <div class="text-slate-600 text-6xl">📦</div>
                            <%c++ } %>
                        </div>
                        <div class="p-6 flex flex-col flex-grow">
                            <h3 class="text-xl font-bold mb-2 group-hover:text-cyan-400 transition truncate"><a href="/product/<%c++ index_tmp_stream << p.at("id"); %>"><%c++ index_tmp_stream << p.at("title"); %></a></h3>
                            <p class="text-fuchsia-400 font-black text-2xl mb-4">$<%c++ index_tmp_stream << p.at("price"); %></p>
                            
                            <div class="flex gap-2 mt-auto">
                                <form action="/cart/add" method="POST" class="flex-grow">
                                    <input type="hidden" name="product_id" value="<%c++ index_tmp_stream << p.at("id"); %>">
                                    <button class="w-full py-3 rounded-xl bg-slate-800 hover:bg-cyan-500 text-slate-300 hover:text-slate-900 font-bold transition-all flex items-center justify-center gap-2">
                                        <span>+ 🛒</span>
                                    </button>
                                </form>
                                <a href="/wishlist/add/<%c++ index_tmp_stream << p.at("id"); %>" class="px-4 py-3 rounded-xl bg-slate-800 hover:bg-fuchsia-500 text-fuchsia-400 hover:text-white transition-all flex items-center justify-center">
                                    ❤️
                                </a>
                            </div>
                        </div>
                    </div>
                <%c++ } %>
            </div>
        </section>
    </main>

    <footer class="border-t border-slate-800 text-center py-8 text-slate-500 text-sm mt-auto">
        &copy; 2026 CyberShop | Powered by Drogon C++
    </footer>
</body>
</html>
