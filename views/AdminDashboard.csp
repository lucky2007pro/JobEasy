<%inc 
    #include <json/json.h> 
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop Admin | Mahsulotlar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style> 
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .sidebar { background: #ffffff; border-right: 1px solid #e2e8f0; }
        .sidebar-link { color: #64748b; transition: all 0.2s; border-radius: 8px; }
        .sidebar-link:hover { background: #f8fafc; color: #b45309; }
        .sidebar-link.active { background: #fef3c7; color: #b45309; font-weight: 700; }
        .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; }
        .btn-amber { background: #b45309; color: white; border-radius: 8px; transition: all 0.2s; }
        .btn-amber:hover { background: #92400e; }
        table th { background: #f8fafc; color: #64748b; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; padding: 12px 24px; border-bottom: 1px solid #e2e8f0; }
        table td { padding: 14px 24px; border-bottom: 1px solid #f1f5f9; font-size: 13px; }
    </style>
</head>
<body class="flex h-screen overflow-hidden">
    <aside class="w-64 sidebar flex flex-col z-30 shrink-0">
        <div class="p-6 flex items-center gap-2">
            <div class="w-7 h-7 bg-amber-700 rounded-lg flex items-center justify-center text-white font-black text-xs">C</div>
            <h2 class="text-base font-bold text-slate-800 tracking-tight">CyberShop Admin</h2>
        </div>
        <nav class="flex-grow px-4 space-y-1 mt-4">
            <a href="/admin/dashboard" class="sidebar-link active flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>📦</span> Mahsulotlar
            </a>
            <a href="/admin/analytics" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>📊</span> Analitika
            </a>
            <a href="/admin/orders" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>🚚</span> Buyurtmalar
            </a>
            <a href="/admin/categories" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>📁</span> Kategoriyalar
            </a>
            <div class="pt-6 mt-6 border-t border-slate-50">
                <p class="text-[9px] text-slate-400 font-black uppercase tracking-widest mb-3 px-4">Tizim</p>
                <a href="/" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs">
                    <span>🌐</span> Saytga o'tish
                </a>
                <a href="/api/logout" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs text-red-500 hover:bg-red-50">
                    <span>🚪</span> Chiqish
                </a>
            </div>
        </nav>
    </aside>

    <main class="flex-1 overflow-y-auto flex flex-col">
        <header class="h-14 bg-white border-b border-slate-200 flex items-center justify-between px-8 sticky top-0 z-20">
            <div class="flex items-center gap-2 text-[11px] font-bold text-slate-400 uppercase tracking-widest">
                <span>Boshqaruv</span> <span class="text-slate-200">/</span> <span class="text-slate-800">Mahsulotlar</span>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-right">
                    <p class="text-[11px] font-bold text-slate-800"><%c++ AdminDashboard_tmp_stream << @@.get<std::string>("user_name"); %></p>
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter leading-none">Admin Panel</p>
                </div>
            </div>
        </header>

        <div class="p-8 max-w-7xl mx-auto w-full space-y-6">
            <div class="flex justify-between items-end">
                <div class="space-y-1">
                    <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Mahsulotlar</h1>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Invertar va mahsulotlar boshqaruvi</p>
                </div>
                <a href="/admin/product/add" class="btn-amber px-6 py-2.5 font-bold text-[11px] uppercase tracking-widest shadow-lg shadow-amber-900/10">
                    Yangi mahsulot
                </a>
            </div>

            <div class="card overflow-hidden">
                <table class="w-full text-left">
                    <thead>
                        <tr>
                            <th>Mahsulot</th>
                            <th>Narxi</th>
                            <th>Zaxira</th>
                            <th class="text-right">Amallar</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        <%c++ 
                            using ProdItem = std::map<std::string, std::string>;
                            auto &products = @@.get<std::vector<ProdItem>>("products_list");
                            for(auto &row : products) { 
                        %>
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-slate-50 border border-slate-100 rounded-lg overflow-hidden flex items-center justify-center shrink-0">
                                        <%c++ if (!row.at("image_url").empty()) { %>
                                            <img src="<%c++ AdminDashboard_tmp_stream << row.at("image_url"); %>" class="w-full h-full object-contain">
                                        <%c++ } else { %>
                                            <span class="text-xs opacity-20">📦</span>
                                        <%c++ } %>
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-800"><%c++ AdminDashboard_tmp_stream << row.at("title"); %></div>
                                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter">ID: #<%c++ AdminDashboard_tmp_stream << row.at("id"); %></div>
                                    </div>
                                </div>
                            </td>
                            <td class="font-black text-amber-700">$<%c++ AdminDashboard_tmp_stream << row.at("price"); %></td>
                            <td>
                                <input type="number" value="<%c++ AdminDashboard_tmp_stream << row.at("stock"); %>" 
                                       class="w-16 h-8 text-center text-xs font-black bg-slate-50 border border-slate-200 rounded-lg outline-none focus:border-amber-700 transition"
                                       onchange="updateStock(<%c++ AdminDashboard_tmp_stream << row.at("id"); %>, this.value)">
                            </td>
                            <td class="text-right">
                                <div class="flex justify-end gap-2">
                                    <a href="/admin/product/edit/<%c++ AdminDashboard_tmp_stream << row.at("id"); %>" 
                                       class="p-2 hover:bg-slate-100 rounded text-slate-400 transition">✏️</a>
                                    <a href="/admin/product/delete/<%c++ AdminDashboard_tmp_stream << row.at("id"); %>" 
                                       class="p-2 hover:bg-red-50 rounded text-red-300 hover:text-red-500 transition"
                                       onclick="return confirm('Ishonchingiz komilmi?')">🗑️</a>
                                </div>
                            </td>
                        </tr>
                        <%c++ } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
        async function updateStock(id, val) {
            try {
                const res = await fetch('/admin/product/update-stock', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `product_id=${id}&stock=${val}`
                });
                const data = await res.json();
                if (data.status !== 'success') alert('Xatolik yuz berdi');
            } catch (e) {
                console.error(e);
            }
        }
    </script>
</body>
</html>
  </script>
</body>
</html>