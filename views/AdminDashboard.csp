<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <title>CyberShop Admin | Boshqaruv</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Outfit', sans-serif; background-color: #0f172a; color: #f8fafc; } .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }</style>
</head>
<body class="flex h-screen overflow-hidden">
    <div class="w-72 glass shadow-2xl flex flex-col z-20 border-r border-slate-700/50">
        <div class="p-8 border-b border-slate-800">
            <h2 class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500">CyberAdmin</h2>
        </div>
        <nav class="flex-grow p-4 space-y-2">
            <a href="/admin/dashboard" class="block py-3 px-6 bg-slate-800/50 text-cyan-400 border border-slate-700 rounded-xl font-bold shadow-[0_0_15px_rgba(34,211,238,0.1)]">Mahsulotlar</a>
            <a href="/" class="block py-3 px-6 text-slate-400 hover:text-white hover:bg-slate-800/50 rounded-xl transition">Do'konni ko'rish</a>
        </nav>
        <div class="p-6 border-t border-slate-800">
            <a href="/api/logout" class="block text-center py-3 px-6 text-red-400 border border-red-500/20 hover:bg-red-500/20 rounded-xl transition font-bold">Chiqish</a>
        </div>
    </div>

    <main class="flex-1 p-10 overflow-y-auto relative bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-[#0f172a] to-[#0f172a]">
        <div class="flex justify-between items-center mb-10">
            <div>
                <h1 class="text-4xl font-black text-white">Ombor Boshqaruvi</h1>
                <p class="text-slate-400 mt-2">Barcha mavjud mahsulotlaringiz shu yerda ro'yxatga olingan.</p>
            </div>
            <a href="/admin/product/add" class="bg-gradient-to-r from-emerald-500 to-teal-500 text-white px-8 py-3 rounded-xl font-black border border-emerald-400/50 hover:shadow-[0_0_20px_rgba(16,185,129,0.5)] transition-all transform hover:-translate-y-1">
                + Yangi Qo'shish
            </a>
        </div>

        <div class="glass rounded-[2rem] overflow-hidden shadow-2xl border border-slate-700/50">
            <table class="w-full text-left">
                <thead class="bg-slate-900 border-b border-slate-800">
                    <tr>
                        <th class="px-8 py-6 text-sm font-black text-cyan-500 tracking-wider uppercase">ID</th>
                        <th class="px-8 py-6 text-sm font-black text-cyan-500 tracking-wider uppercase">Sarlavha</th>
                        <th class="px-8 py-6 text-sm font-black text-cyan-500 tracking-wider uppercase">Narxi</th>
                        <th class="px-8 py-6 text-sm font-black text-cyan-500 tracking-wider uppercase">Omborda</th>
                        <th class="px-8 py-6 text-sm font-black text-cyan-500 tracking-wider uppercase text-right">Amallar</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/50">
                    <%c++ 
                        using ProdItem = std::map<std::string, std::string>;
                        auto &products = @@.get<std::vector<ProdItem>>("products_list");
                        for(auto &row : products) { 
                    %>
                    <tr class="hover:bg-slate-800/30 transition group">
                        <td class="px-8 py-5 font-mono text-slate-500">#<%c++ AdminDashboard_tmp_stream << row.at("id"); %></td>
                        <td class="px-8 py-5 font-bold text-slate-200 group-hover:text-cyan-300 transition"><%c++ AdminDashboard_tmp_stream << row.at("title"); %></td>
                        <td class="px-8 py-5 text-fuchsia-400 font-bold">$<%c++ AdminDashboard_tmp_stream << row.at("price"); %></td>
                        <td class="px-8 py-5">
                            <span class="bg-slate-800 border border-slate-600 text-slate-300 px-3 py-1 rounded-full text-xs font-bold">
                                <%c++ AdminDashboard_tmp_stream << row.at("stock"); %> dona
                            </span>
                        </td>
                        <td class="px-8 py-5 text-right">
                            <a href="/admin/delete/<%c++ AdminDashboard_tmp_stream << row.at("id"); %>" 
                               class="inline-block bg-red-500/10 text-red-400 border border-red-500/30 px-4 py-2 rounded-lg text-sm font-bold hover:bg-red-500 hover:text-white transition"
                               onclick="return confirm('Rostdan ham o\'chirmoqchimisiz?')">
                                O'chirish
                            </a>
                        </td>
                    </tr>
                    <%c++ } %>
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>