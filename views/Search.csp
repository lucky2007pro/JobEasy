<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Qidiruv | CyberShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style> 
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .glass-header { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); border-bottom: 1px solid #e2e8f0; }
        .product-card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .product-card:hover { border-color: #b45309; transform: translateY(-4px); box-shadow: 0 12px 24px -10px rgba(180, 83, 9, 0.1); }
        .btn-amber { background: #b45309; color: white; border-radius: 8px; font-weight: 700; transition: all 0.2s; }
        .btn-amber:hover { background: #92400e; }
        .search-input { background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 16px; outline: none; width: 100%; transition: all 0.2s; }
        .search-input:focus { background: #ffffff; border-color: #b45309; }
    </style>
</head>
<body class="min-h-screen flex flex-col pb-20 md:pb-0">
    <%c++
        auto is_logged_in = @@.get<bool>("is_logged_in");
        auto &name = @@.get<std::string>("user_name");
    %>

    <header class="glass-header sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center gap-8">
            <a href="/" class="flex items-center gap-2 flex-shrink-0">
                <div class="w-8 h-8 bg-amber-700 rounded-lg flex items-center justify-center text-white font-black">C</div>
                <span class="text-xl font-bold text-slate-800 tracking-tight">CyberShop</span>
            </a>
            
            <form action="/search" method="GET" class="flex-grow max-w-2xl">
                <div class="relative group">
                    <input 
                        type="text" 
                        name="q" 
                        value="<%c++ Search_tmp_stream << @@.get<std::string>("search_query"); %>"
                        placeholder="Nima qidiramiz?" 
                        class="search-input text-sm font-medium text-slate-700"
                    >
                    <button type="submit" class="absolute right-2 top-1.5 p-2 text-slate-400 hover:text-amber-700">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </button>
                </div>
            </form>

            <div class="hidden md:flex items-center gap-6 flex-shrink-0">
                <a href="/wishlist" class="text-[10px] font-black text-slate-400 hover:text-amber-700 uppercase tracking-widest">SEVIMLI</a>
                <a href="/cart" class="text-[10px] font-black text-slate-400 hover:text-amber-700 uppercase tracking-widest">SAVAT</a>
                <%c++ if (is_logged_in) { %>
                    <a href="/profile" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-[10px] font-black text-slate-700"><%c++ Search_tmp_stream << name.substr(0,1); %></a>
                <%c++ } else { %>
                    <a href="/login" class="text-[10px] font-black text-amber-700 uppercase tracking-widest bg-amber-50 px-3 py-1.5 rounded">KIRISH</a>
                <%c++ } %>
            </div>
            
            <div class="flex md:hidden items-center gap-4 flex-shrink-0">
                <a href="/cart" class="text-slate-400 hover:text-amber-700 text-lg transition">🛒</a>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto px-6 py-12 w-full space-y-10">
        <div class="space-y-1">
            <h1 class="text-3xl font-bold text-slate-800 tracking-tight">Qidiruv Natijalari</h1>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none">Natijalar: "<span class="text-amber-700"><%c++ Search_tmp_stream << @@.get<std::string>("search_query"); %></span>"</p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
            <%c++ 
                using ProdItem = std::map<std::string, std::string>;
                auto &products = @@.get<std::vector<ProdItem>>("products_list");
                if (products.empty()) { %>
                    <div class="col-span-full py-24 text-center space-y-4">
                        <div class="text-4xl">🔍</div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Afsuski, hech narsa topilmadi</p>
                        <a href="/" class="inline-block text-[10px] font-black text-amber-700 uppercase tracking-widest bg-amber-50 px-6 py-3 rounded-lg">HAMMA MAHSULOTLARGA QAYTISH</a>
                    </div>
                <%c++ } else {
                    for(auto &row : products) { 
                %>
                <div class="product-card flex flex-col">
                    <a href="/product/<%c++ Search_tmp_stream << row.at("id"); %>" class="h-48 bg-slate-50 flex items-center justify-center p-4 relative group">
                        <img src="<%c++ Search_tmp_stream << row.at("image_url"); %>" class="max-h-full object-contain transition-transform duration-500 group-hover:scale-110">
                        <%c++ if(row.at("discount_percentage") != "0"){ %>
                            <span class="absolute top-2 right-2 bg-amber-700 text-white text-[9px] font-black px-2 py-1 rounded">
                                -<%c++ Search_tmp_stream << row.at("discount_percentage"); %>%
                            </span>
                        <%c++ } %>
                    </a>
                    <div class="p-4 flex-grow flex flex-col space-y-4">
                        <div class="space-y-1 min-h-[40px]">
                            <h3 class="text-[11px] font-bold text-slate-800 line-clamp-2 uppercase tracking-tight leading-tight"><%c++ Search_tmp_stream << row.at("title"); %></h3>
                            <p class="text-[13px] font-black text-amber-700"><%c++ Search_tmp_stream << row.at("price"); %> so'm</p>
                        </div>
                        
                        <form action="/cart/add" method="POST" class="mt-auto">
                            <input type="hidden" name="csrf_token" value="<%c++ Search_tmp_stream << @@.get<std::string>("csrf_token"); %>">
                            <input type="hidden" name="product_id" value="<%c++ Search_tmp_stream << row.at("id"); %>">
                            <button class="w-full btn-amber py-2.5 text-[9px] uppercase tracking-widest">SAVATGA QO'SHISH</button>
                        </form>
                    </div>
                </div>
                <%c++ } } %>
        </div>
    </main>

    <footer class="mt-auto py-10 px-6 border-t border-slate-200 text-center">
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">&copy; 2026 CyberShop &middot; Biz bilan kelajak yaqin</p>
    </footer>
    <!-- Mobile Bottom Nav -->
    <nav class="md:hidden fixed bottom-0 left-0 w-full bg-white border-t border-slate-200 z-50 px-6 py-3 flex justify-between items-center text-slate-400 shadow-[0_-4px_10px_rgba(0,0,0,0.05)] pb-6 p-safe">
        <a href="/" class="flex flex-col items-center hover:text-amber-700 transition">
            <span class="text-xl leading-none">🏠</span>
            <span class="text-[8px] font-black uppercase mt-1">Asosiy</span>
        </a>
        <a href="/search" class="flex flex-col items-center hover:text-amber-700 text-amber-700 transition">
            <span class="text-xl leading-none">🔍</span>
            <span class="text-[8px] font-black uppercase mt-1">Qidiruv</span>
        </a>
        <a href="/cart" class="flex flex-col items-center hover:text-amber-700 transition">
            <span class="text-xl leading-none">🛒</span>
            <span class="text-[8px] font-black uppercase mt-1">Savat</span>
        </a>
        <a href="/wishlist" class="flex flex-col items-center hover:text-amber-700 transition">
            <span class="text-xl leading-none">❤️</span>
            <span class="text-[8px] font-black uppercase mt-1">Sevimli</span>
        </a>
        <a href="/profile" class="flex flex-col items-center hover:text-amber-700 transition">
            <span class="text-xl leading-none">👤</span>
            <span class="text-[8px] font-black uppercase mt-1">Profil</span>
        </a>
    </nav>
</body>
</html>
