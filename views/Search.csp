<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <title>Qidiruv Natijalari | CyberShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Outfit', sans-serif; background-color: #0f172a; color: #f8fafc; } .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }</style>
</head>
<body class="min-h-screen bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-[#0f172a] to-[#0f172a] pb-20">
    <nav class="glass sticky top-0 z-50 border-b border-slate-700/50 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <a href="/" class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500">CyberShop</a>
            <form action="/search" method="GET" class="flex-1 max-w-xl mx-8 relative">
                <input type="text" name="q" value="<%c++ Search_tmp_stream << @@.get<std::string>("search_query"); %>" placeholder="Mahsulot qidirish..." class="w-full bg-slate-800/50 border border-slate-700 text-white px-6 py-3 rounded-full focus:outline-none focus:ring-2 focus:ring-cyan-500 shadow-xl transition">
                <button type="submit" class="absolute right-2 top-1.5 bg-cyan-500 p-2 rounded-full hover:bg-cyan-400 transition">
                    <svg class="w-5 h-5 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </button>
            </form>
            <div class="space-x-6 text-slate-300 font-bold flex items-center">
                <a href="/profile" class="hover:text-fuchsia-400 transition">Profil</a>
                <a href="/cart" class="hover:text-cyan-400 transition">Savat</a>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-6 mt-12">
        <h1 class="text-3xl font-bold mb-8">Natijalar: <span class="text-cyan-400">"<%c++ Search_tmp_stream << @@.get<std::string>("search_query"); %>"</span></h1>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <%c++ 
                using ProdItem = std::map<std::string, std::string>;
                auto &products = @@.get<std::vector<ProdItem>>("products_list");
                if (products.empty()) { 
                    Search_tmp_stream << "<p class='col-span-4 text-center text-slate-500'>Hech narsa topilmadi.</p>";
                }
                for(auto &row : products) { 
            %>
            <div class="glass rounded-3xl overflow-hidden hover:scale-105 transition-transform duration-300 group border border-slate-700/50 hover:border-cyan-500/50 flex flex-col">
                <div class="h-48 overflow-hidden relative">
                    <img src="<%c++ Search_tmp_stream << row.at("image_url"); %>" class="w-full h-full object-cover group-hover:opacity-75 transition-opacity" alt="product">
                    <%c++ if(row.at("discount_percentage") != "0"){ %>
                        <span class="absolute top-3 right-3 bg-fuchsia-500 text-white text-xs font-black px-3 py-1 rounded-full shadow-lg">
                            -<%c++ Search_tmp_stream << row.at("discount_percentage"); %>%
                        </span>
                    <%c++ } %>
                </div>
                <div class="p-6 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="text-xl font-bold text-slate-200 mb-2 truncate"><%c++ Search_tmp_stream << row.at("title"); %></h3>
                        <p class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500 mb-4">$<%c++ Search_tmp_stream << row.at("price"); %></p>
                    </div>
                    <a href="/product/<%c++ Search_tmp_stream << row.at("id"); %>" class="block text-center bg-slate-800 hover:bg-slate-700 text-white font-bold py-3 px-6 rounded-xl transition border border-slate-600 w-full">Ko'rish</a>
                </div>
            </div>
            <%c++ } %>
        </div>
    </div>
</body>
</html>
