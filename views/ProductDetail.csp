<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop | Mahsulot tafsiloti</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style> 
        body { font-family: 'Outfit', sans-serif; background-color: #0f172a; color: #f8fafc; }
        .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <%c++
        using ProductItem = std::map<std::string, std::string>;
        auto &product = @@.get<ProductItem>("product");
        auto is_logged_in = @@.get<bool>("is_logged_in");
    %>
    
    <nav class="glass sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <a href="/" class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500 tracking-tighter">CyberShop</a>
            <div class="flex space-x-6">
                <a href="/cart" class="text-slate-300 hover:text-cyan-400 font-semibold transition">Savatcha 🛒</a>
            </div>
        </div>
    </nav>

    <main class="flex-grow max-w-7xl mx-auto py-16 px-6 w-full">
        <div class="glass rounded-[3rem] p-8 md:p-12 shadow-2xl flex flex-col md:flex-row gap-12">
            <div class="md:w-1/2 bg-slate-900 rounded-3xl p-8 flex items-center justify-center min-h-[400px] border border-slate-700 hover:border-cyan-500/50 transition">
                <%c++ if (!product.at("image_url").empty()) { %>
                    <img src="<%c++ ProductDetail_tmp_stream << product.at("image_url"); %>" alt="Product" class="max-h-full object-contain">
                <%c++ } else { %>
                    <div class="text-slate-600 text-8xl">📦</div>
                <%c++ } %>
            </div>
            
            <div class="md:w-1/2 flex flex-col justify-center">
                <div class="mb-4 inline-block px-3 py-1 glass rounded-full text-xs text-cyan-400 font-bold uppercase tracking-widest border border-cyan-400/30">
                    Omborda: <%c++ ProductDetail_tmp_stream << product.at("stock"); %> ta
                </div>
                <h1 class="text-4xl md:text-5xl font-black mb-6"><%c++ ProductDetail_tmp_stream << product.at("title"); %></h1>
                <p class="text-fuchsia-400 font-black text-4xl mb-8">$<%c++ ProductDetail_tmp_stream << product.at("price"); %></p>
                <div class="prose prose-invert max-w-none text-slate-300 mb-10 leading-relaxed font-light">
                    <%c++ ProductDetail_tmp_stream << product.at("description"); %>
                </div>
                
                <form action="/cart/add" method="POST" class="mt-auto flex gap-4">
                    <input type="hidden" name="product_id" value="<%c++ ProductDetail_tmp_stream << product.at("id"); %>">
                    <input type="number" name="quantity" value="1" min="1" max="<%c++ ProductDetail_tmp_stream << product.at("stock"); %>" 
                        class="w-24 bg-slate-800 border border-slate-600 rounded-xl px-4 text-xl font-bold text-center focus:outline-none focus:border-cyan-400">
                    <button class="flex-grow bg-gradient-to-r from-cyan-500 to-blue-600 text-white py-4 rounded-xl font-black text-lg hover:shadow-[0_0_20px_rgba(34,211,238,0.6)] transition-all transform hover:-translate-y-1 border border-cyan-400/50">
                        Savatchaga qo'shish
                    </button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
