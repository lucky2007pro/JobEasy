<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop | Mahsulot tafsiloti</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style> 
        :root { --bg: #0f172a; --text: #f8fafc; --glass: rgba(255, 255, 255, 0.05); --border: rgba(255, 255, 255, 0.1); }
        .light { --bg: #f8fafc; --text: #0f172a; --glass: rgba(0, 0, 0, 0.05); --border: rgba(0, 0, 0, 0.1); }
        body { font-family: 'Outfit', sans-serif; background-color: var(--bg); color: var(--text); transition: background-color 0.3s, color 0.3s; }
        .glass { background: var(--glass); backdrop-filter: blur(10px); border: 1px solid var(--border); }
    </style>
    <script>
        if (localStorage.theme === 'light' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: light)').matches)) {
            document.documentElement.classList.add('light')
        } else {
            document.documentElement.classList.remove('light')
        }
        function toggleTheme() {
            if (document.documentElement.classList.contains('light')) {
                document.documentElement.classList.remove('light');
                localStorage.theme = 'dark';
            } else {
                document.documentElement.classList.add('light');
                localStorage.theme = 'light';
            }
        }
    </script>
</head>
<body class="min-h-screen flex flex-col">
    <%c++
        using ProductItem = std::map<std::string, std::string>;
        auto &product = @@.get<ProductItem>("product");
        auto is_logged_in = @@.get<bool>("is_logged_in");
    %>
    
    <nav class="glass sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <a href="/" class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500 tracking-tighter">CyberShop</a>
            <div class="flex items-center space-x-6">
                <button onclick="toggleTheme()" class="w-10 h-10 glass rounded-xl flex items-center justify-center hover:scale-110 transition">🌓</button>
                <a href="/" class="text-slate-300 hover:text-cyan-400 font-semibold transition">Bosh sahifa</a>
                <a href="/wishlist" class="text-slate-300 hover:text-cyan-400 font-semibold transition">Sevimlilar ❤️</a>
                <a href="/cart" class="text-slate-300 hover:text-cyan-400 font-semibold transition">Savatcha 🛒</a>
            </div>
        </div>
    </nav>

    <main class="flex-grow max-w-7xl mx-auto py-16 px-6 w-full">
        <div class="glass rounded-[3rem] p-8 md:p-12 shadow-2xl flex flex-col md:flex-row gap-12">
            <div class="md:w-1/2 bg-slate-900 rounded-3xl p-8 flex items-center justify-center min-h-[400px] border border-slate-700 hover:border-cyan-500/50 transition">
                <%c++ if (!product.at("image_url").empty()) { %>
                    <img src="<%c++ ProductDetail_tmp_stream << product.at("image_url"); %>" alt="Product" class="max-h-full object-contain">
                <%c++ } else { %>
                    <div class="text-slate-600 text-8xl">📦</div>
                <%c++ } %>
            </div>
            
            <div class="md:w-1/2 flex flex-col justify-center">
                <div class="mb-4 inline-block px-3 py-1 glass rounded-full text-xs text-cyan-400 font-bold uppercase tracking-widest border border-cyan-400/30">
                    Omborda: <%c++ ProductDetail_tmp_stream << product.at("stock"); %> ta
                </div>
                <h1 class="text-4xl md:text-5xl font-black mb-6"><%c++ ProductDetail_tmp_stream << product.at("title"); %></h1>
                <p class="text-fuchsia-400 font-black text-4xl mb-8">$<%c++ ProductDetail_tmp_stream << product.at("price"); %></p>
                <div class="prose prose-invert max-w-none text-slate-300 mb-10 leading-relaxed font-light">
                    <%c++ ProductDetail_tmp_stream << product.at("description"); %>
                </div>
                
                <form action="/cart/add" method="POST" class="mt-auto flex gap-4">
                    <input type="hidden" name="product_id" value="<%c++ ProductDetail_tmp_stream << product.at("id"); %>">
                    <input type="number" name="quantity" value="1" min="1" max="<%c++ ProductDetail_tmp_stream << product.at("stock"); %>" 
                        class="w-24 bg-slate-800 border border-slate-600 rounded-xl px-4 text-xl font-bold text-center focus:outline-none focus:border-cyan-400">
                    <button class="flex-grow bg-gradient-to-r from-cyan-500 to-blue-600 text-white py-4 rounded-xl font-black text-lg hover:shadow-[0_0_20px_rgba(34,211,238,0.6)] transition-all transform hover:-translate-y-1 border border-cyan-400/50">
                        Savatchaga qo'shish
                    </button>
                    <a href="/wishlist/add/<%c++ ProductDetail_tmp_stream << product.at("id"); %>" class="w-16 h-16 glass rounded-xl flex items-center justify-center text-2xl text-fuchsia-400 hover:bg-fuchsia-500 hover:text-white transition shadow-lg border border-fuchsia-400/30">
                        ❤️
                    </a>
                </form>
            </div>
        </div>
        </div>
        
        <!-- Reviews Section -->
        <div class="mt-12 glass rounded-[3rem] p-8 md:p-12 shadow-2xl border border-slate-700/50">
            <h2 class="text-3xl font-bold mb-8">Izohlar va Baholar</h2>
            
            <%c++ if (is_logged_in) { %>
            <div class="mb-10 bg-slate-900/50 p-6 rounded-2xl border border-slate-800">
                <form action="/api/review" method="POST" class="space-y-4">
                    <input type="hidden" name="product_id" value="<%c++ ProductDetail_tmp_stream << product.at("id"); %>">
                    <div>
                        <label class="block text-sm font-bold text-slate-400 uppercase mb-2">Baholang (1 dan 5 gacha)</label>
                        <select name="rating" class="p-3 bg-slate-800 focus:outline-none border border-slate-600 rounded-xl text-white">
                            <option value="5">⭐⭐⭐⭐⭐ Juda zo'r!</option>
                            <option value="4">⭐⭐⭐⭐ Yaxshi</option>
                            <option value="3">⭐⭐⭐ O'rtacha</option>
                            <option value="2">⭐⭐ Menga yoqmadi</option>
                            <option value="1">⭐ Rostdan ham yomon</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-400 uppercase mb-2">Fikringiz</label>
                        <textarea name="comment" rows="3" class="w-full p-4 bg-slate-800 border border-slate-600 rounded-xl text-white outline-none focus:border-cyan-500" placeholder="Mahsulot haqida nima deysiz?"></textarea>
                    </div>
                    <button class="bg-cyan-500 text-slate-900 px-6 py-3 rounded-xl font-bold hover:bg-cyan-400 transition">Izohni yuborish</button>
                </form>
            </div>
            <%c++ } else { %>
            <div class="mb-10 p-6 bg-slate-800/30 rounded-2xl border border-slate-800 text-center">
                <p class="text-slate-400">Izoh qoldirish uchun tizimga kiring.</p>
                <a href="/api/login" class="text-cyan-400 font-bold hover:underline mt-2 inline-block">Tizimga kirish</a>
            </div>
            <%c++ } %>

            <div class="space-y-6">
                <!-- Static UI mockup for reviews -->
                <div class="p-6 bg-slate-900/30 rounded-2xl border border-slate-800">
                    <div class="flex justify-between items-start mb-4">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 bg-gradient-to-br from-cyan-400 to-fuchsia-500 rounded-full flex items-center justify-center text-white font-bold">U</div>
                            <div>
                                <h4 class="font-bold text-slate-200">Foydalanuvchi</h4>
                                <span class="text-xs text-slate-500">Biroz oldin</span>
                            </div>
                        </div>
                        <div class="text-yellow-400 tracking-widest">⭐⭐⭐⭐⭐</div>
                    </div>
                    <p class="text-slate-300 font-light">Bu mahsulot kutilganidan juda zo'r ekan! Menga manzur keldi.</p>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
