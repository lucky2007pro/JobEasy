<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop Admin | Mahsulot qo'shish</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Outfit', sans-serif; background-color: #0f172a; color: #f8fafc; } .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }</style>
</head>
<body class="min-h-screen py-12 px-6 flex items-center justify-center relative">
    <div class="fixed top-0 left-0 w-full h-full pointer-events-none -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-cyan-900/20 via-[#0f172a] to-[#0f172a]"></div>
    
    <div class="w-full max-w-2xl">
        <a href="/admin/dashboard" class="inline-flex items-center gap-2 text-cyan-400 hover:text-cyan-300 font-bold mb-8 transition group">
            <span class="group-hover:-translate-x-1 transition transform">←</span> Boshqaruv paneliga qaytish
        </a>

        <div class="glass p-10 rounded-[2.5rem] shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-cyan-400 to-fuchsia-500"></div>
            
            <div class="mb-10 text-center">
                <h1 class="text-4xl font-black text-white mb-2">Yangi Mahsulot</h1>
                <p class="text-slate-400">Do'koningiz assortimentini yangilang.</p>
            </div>

            <form action="/admin/product/add" method="POST" class="space-y-6">
                <div>
                    <label class="block text-sm font-bold text-slate-300 mb-2 tracking-wide uppercase">Nomi</label>
                    <input type="text" name="title" required class="w-full bg-slate-900/50 border border-slate-700 p-4 rounded-xl focus:outline-none focus:border-cyan-400 text-white transition placeholder-slate-600" placeholder="Masalan: CyberPhone X">
                </div>
                
                <div>
                    <label class="block text-sm font-bold text-slate-300 mb-2 tracking-wide uppercase">Rasm URL</label>
                    <input type="text" name="image_url" class="w-full bg-slate-900/50 border border-slate-700 p-4 rounded-xl focus:outline-none focus:border-cyan-400 text-white transition placeholder-slate-600" placeholder="https://...">
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-300 mb-2 tracking-wide uppercase">Narxi ($)</label>
                        <input type="number" step="0.01" name="price" required class="w-full bg-slate-900/50 border border-slate-700 p-4 rounded-xl focus:outline-none focus:border-cyan-400 text-white transition placeholder-slate-600" placeholder="999.99">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-300 mb-2 tracking-wide uppercase">Omborda (dona)</label>
                        <input type="number" name="stock" required class="w-full bg-slate-900/50 border border-slate-700 p-4 rounded-xl focus:outline-none focus:border-cyan-400 text-white transition placeholder-slate-600" placeholder="100">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-bold text-slate-300 mb-2 tracking-wide uppercase">Batafsil ma'lumot</label>
                    <textarea name="description" rows="4" class="w-full bg-slate-900/50 border border-slate-700 p-4 rounded-xl focus:outline-none focus:border-fuchsia-400 text-white transition placeholder-slate-600 resize-none" placeholder="Mahsulot haqida..."></textarea>
                </div>
                
                <button type="submit" class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-black py-4 rounded-xl hover:shadow-[0_0_20px_rgba(34,211,238,0.5)] transition-all mt-4 border border-cyan-400/30">
                    Mahsulotni yaratish
                </button>
            </form>
        </div>
    </div>
</body>
</html>
