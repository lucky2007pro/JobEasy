<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop | Profil</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style> 
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .glass-header { background: rgba(255, 255, 255, 0.82); backdrop-filter: blur(16px); border-bottom: 1px solid #e2e8f0; }
        .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; }
        .input-field { background: #fdfdfd; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 14px; width: 100%; outline: none; transition: all 0.2s; font-size: 13px; font-weight: 500; }
        .input-field:focus { border-color: #b45309; background: #ffffff; }
        .btn-amber { background: #b45309; color: white; border-radius: 6px; font-weight: 700; transition: all 0.2s; }
        .btn-amber:hover { background: #92400e; }
    </style>
</head>
<body class="min-h-screen flex flex-col pb-20 md:pb-0">
    <%c++
        using ProfileMap = std::map<std::string, std::string>;
        auto &profile = @@.get<ProfileMap>("profile");
        auto is_logged_in = @@.get<bool>("is_logged_in");
        auto &name = @@.get<std::string>("user_name");
    %>

    <header class="glass-header sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 md:px-8 py-3 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2">
                <div class="w-6 h-6 bg-amber-700 rounded-lg flex items-center justify-center text-white font-black text-[10px]">C</div>
                <span class="text-base font-bold text-slate-800 tracking-tight">CyberShop</span>
            </a>
            <div class="hidden md:flex items-center gap-5">
                <a href="/" class="text-[10px] font-black text-slate-400 hover:text-amber-700 uppercase tracking-widest">DO'KON</a>
                <a href="/cart" class="text-[10px] font-black text-slate-400 hover:text-amber-700 uppercase tracking-widest">SAVAT</a>
                <div class="w-7 h-7 rounded-full bg-amber-50 flex items-center justify-center text-[9px] font-black text-amber-700 border border-amber-100">
                    <%c++ Profile_tmp_stream << (name.empty() ? "?" : name.substr(0,1)); %>
                </div>
            </div>
            <div class="flex md:hidden items-center gap-4 flex-shrink-0">
                <a href="/search" class="text-slate-400 hover:text-amber-700 text-lg transition">🔍</a>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-xl mx-auto px-4 md:px-8 py-12 w-full space-y-8">
        <div class="text-center space-y-1">
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Shaxsiy Profil</h1>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none">Ma'lumotlaringizni boshqarish</p>
        </div>

        <div class="card p-6 md:p-8 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-amber-700/10"></div>
            
            <form action="/api/profile/update" method="POST" class="space-y-5">
                <input type="hidden" name="csrf_token" value="<%c++ Profile_tmp_stream << @@.get<std::string>("csrf_token"); %>">
                
                <div class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Foydalanuvchi</label>
                            <div class="input-field bg-slate-50 border-slate-100 text-slate-400 cursor-not-allowed"><%c++ Profile_tmp_stream << profile.at("full_name"); %></div>
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Email Manzil</label>
                            <div class="input-field bg-slate-50 border-slate-100 text-slate-400 cursor-not-allowed"><%c++ Profile_tmp_stream << profile.at("email"); %></div>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-amber-700 uppercase tracking-widest ml-1">Telefon</label>
                            <input type="text" name="phone_number" value="<%c++ Profile_tmp_stream << profile.at("phone_number"); %>" placeholder="+998" class="input-field">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-amber-700 uppercase tracking-widest ml-1">Shahar</label>
                            <input type="text" name="city" value="<%c++ Profile_tmp_stream << profile.at("city"); %>" placeholder="Toshkent" class="input-field">
                        </div>
                    </div>
                    
                    <div class="space-y-1.5">
                        <label class="text-[10px] font-black text-amber-700 uppercase tracking-widest ml-1">Aniq manzil (Ko'cha/Uy)</label>
                        <textarea name="address_line" rows="2" class="input-field resize-none"><%c++ Profile_tmp_stream << profile.at("address_line"); %></textarea>
                    </div>
                </div>
                
                <div class="pt-6 border-t border-slate-50 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <a href="/logout" class="text-[9px] font-black text-red-400 hover:text-red-500 uppercase tracking-[0.2em] transition-all">TIZIMDAN CHIQISH</a>
                    <button type="submit" class="btn-amber px-10 py-3 text-[10px] uppercase tracking-widest shadow-xl shadow-amber-900/10 w-full sm:w-auto">MA'LUMOTLARNI SAQLASH</button>
                </div>
            </form>
        </div>
        
        <div class="flex items-center justify-center gap-4 text-slate-100">
            <span class="w-10 h-px bg-slate-200"></span>
            <span class="text-[8px] font-black text-slate-300 uppercase tracking-[0.3em]">CyberShop Global 🔒 Secure</span>
            <span class="w-10 h-px bg-slate-200"></span>
        </div>
    </main>

    <footer class="mt-auto py-8 text-center bg-white border-t border-slate-100">
        <p class="text-[9px] font-black text-slate-300 uppercase tracking-[0.2em]">© 2026 CYBERSHOP &middot; DATA PRIVACY</p>
    </footer>
    <!-- Mobile Bottom Nav -->
    <nav class="md:hidden fixed bottom-0 left-0 w-full bg-white border-t border-slate-200 z-50 px-6 py-3 flex justify-between items-center text-slate-400 shadow-[0_-4px_10px_rgba(0,0,0,0.05)] pb-6 p-safe">
        <a href="/" class="flex flex-col items-center hover:text-amber-700 transition">
            <span class="text-xl leading-none">🏠</span>
            <span class="text-[8px] font-black uppercase mt-1">Asosiy</span>
        </a>
        <a href="/search" class="flex flex-col items-center hover:text-amber-700 transition">
            <span class="text-xl leading-none">🔍</span>
            <span class="text-[8px] font-black uppercase mt-1">Qidiruv</span>
        </a>
        <a href="/cart" class="flex flex-col items-center hover:text-amber-700 transition">
            <span class="text-xl leading-none">🛒</span>
            <span class="text-[8px] font-black uppercase mt-1">Savat</span>
        </a>
        <a href="/wishlist" class="flex flex-col items-center hover:text-amber-700 transition">
            <span class="text-xl leading-none">❤️</span>
            <span class="text-[8px] font-black uppercase mt-1">Sevimli</span>
        </a>
        <a href="/profile" class="flex flex-col items-center hover:text-amber-700 text-amber-700 transition">
            <span class="text-xl leading-none">👤</span>
            <span class="text-[8px] font-black uppercase mt-1">Profil</span>
        </a>
    </nav>
</body>
</html>
