<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <title>Mening Kabinetim | CyberShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style> body { font-family: 'Outfit', sans-serif; background-color: #0f172a; color: #f8fafc; } .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }</style>
</head>
<body class="min-h-screen bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-[#0f172a] to-[#0f172a]">
    <nav class="glass sticky top-0 z-50 border-b border-slate-700/50 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <a href="/" class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500">CyberShop</a>
            <div class="space-x-6 text-slate-300 font-bold flex items-center">
                <a href="/orders" class="hover:text-cyan-400 transition">Buyurtmalar</a>
                <a href="/cart" class="hover:text-cyan-400 transition">Savat</a>
                <a href="/api/logout" class="text-red-400 hover:text-red-300 transition">Chiqish</a>
            </div>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto px-6 mt-12 pb-20">
        <h1 class="text-4xl font-black mb-8">Shaxsiy <span class="text-cyan-400">Kabinet</span></h1>
        
        <div class="glass p-10 rounded-3xl border border-slate-700/50 shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-cyan-400 to-fuchsia-500"></div>
            
            <%c++ 
                using ProfileMap = std::map<std::string, std::string>;
                auto &profile = @@.get<ProfileMap>("profile");
            %>
            <form action="/api/profile/update" method="POST" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase mb-2">F.I.SH</label>
                        <input type="text" value="<%c++ Profile_tmp_stream << profile.at("full_name"); %>" disabled class="w-full p-4 bg-slate-900/50 border border-slate-700 rounded-2xl text-slate-500 cursor-not-allowed">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase mb-2">Email</label>
                        <input type="text" value="<%c++ Profile_tmp_stream << profile.at("email"); %>" disabled class="w-full p-4 bg-slate-900/50 border border-slate-700 rounded-2xl text-slate-500 cursor-not-allowed">
                    </div>
                    
                    <div>
                        <label class="block text-xs font-bold text-cyan-400 uppercase mb-2">Telefon raqam</label>
                        <input type="text" name="phone_number" value="<%c++ Profile_tmp_stream << profile.at("phone_number"); %>" placeholder="+998 90 123 45 67" class="w-full p-4 bg-slate-800 border border-slate-600 focus:border-cyan-500 rounded-2xl text-white outline-none transition">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-cyan-400 uppercase mb-2">Shahar / Viloyat</label>
                        <input type="text" name="city" value="<%c++ Profile_tmp_stream << profile.at("city"); %>" placeholder="Toshkent" class="w-full p-4 bg-slate-800 border border-slate-600 focus:border-cyan-500 rounded-2xl text-white outline-none transition">
                    </div>
                    
                    <div class="col-span-1 md:col-span-2">
                        <label class="block text-xs font-bold text-cyan-400 uppercase mb-2">To'liq Manzil</label>
                        <textarea name="address_line" rows="3" class="w-full p-4 bg-slate-800 border border-slate-600 focus:border-cyan-500 rounded-2xl text-white outline-none transition"><%c++ Profile_tmp_stream << profile.at("address_line"); %></textarea>
                    </div>
                </div>
                
                <div class="pt-6 border-t border-slate-800 flex justify-end">
                    <button type="submit" class="bg-gradient-to-r from-cyan-500 to-blue-600 text-white px-10 py-4 rounded-xl font-bold hover:shadow-[0_0_20px_rgba(34,211,238,0.5)] transition-all">
                        Saqlash va Yangilash
                    </button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
