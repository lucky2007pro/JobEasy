<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop | Sevimlilar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style> 
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .glass-header { background: rgba(255, 255, 255, 0.82); backdrop-filter: blur(16px); border-bottom: 1px solid #e2e8f0; }
        .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; transition: all 0.2s; }
        .card:hover { border-color: #b45309; transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(180, 83, 9, 0.1); }
        .btn-amber { background: #b45309; color: white; border-radius: 6px; font-weight: 700; transition: all 0.2s; }
        .btn-amber:hover { background: #92400e; }
        .btn-slate { background: #f1f5f9; color: #475569; border-radius: 6px; font-weight: 700; transition: all 0.2s; }
        .btn-slate:hover { background: #e2e8f0; color: #1e293b; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <%c++
        using ProductItem = std::map<std::string, std::string>;
        auto &items = @@.get<std::vector<ProductItem>>("wishlist_items");
        auto &name = @@.get<std::string>("user_name");
        auto is_logged_in = @@.get<bool>("is_logged_in");
    %>
    
    <header class="glass-header sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 md:px-8 py-3 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2">
                <div class="w-6 h-6 bg-amber-700 rounded-lg flex items-center justify-center text-white font-black text-[10px]">C</div>
                <span class="text-base font-bold text-slate-800 tracking-tight">CyberShop</span>
            </a>
            <div class="flex items-center gap-5">
                <a href="/" class="text-[10px] font-black text-slate-400 hover:text-amber-700 uppercase tracking-widest">DO'KON</a>
                <a href="/cart" class="text-[10px] font-black text-slate-400 hover:text-amber-700 uppercase tracking-widest">SAVAT</a>
                <div class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-[9px] font-black text-slate-600 border border-slate-200">
                    <%c++ Wishlist_tmp_stream << (name.empty() ? "?" : name.substr(0,1)); %>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto px-4 md:px-8 py-10 w-full space-y-8">
        <div class="space-y-1">
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Tanlanganlar</h1>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none">Sevimlilar ro'yxati</p>
        </div>

        <%c++ if (items.empty()) { %>
            <div class="card p-16 text-center space-y-4 border-dashed bg-slate-50/20">
                <div class="text-3xl opacity-20">❤️</div>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Hali sevimlilarga hech narsa qo'shilmagan</p>
                <a href="/" class="inline-block btn-amber px-8 py-2.5 text-[10px] uppercase tracking-widest shadow-xl shadow-amber-900/10">DO'KONNI KO'RISH</a>
            </div>
        <%c++ } else { %>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
                <%c++ for(auto &p : items) { %>
                    <div class="card flex flex-col p-3 relative group">
                        <form action="/wishlist/remove/<%c++ Wishlist_tmp_stream << p.at("id"); %>" method="POST" class="absolute top-2 right-2 z-10">
                            <input type="hidden" name="csrf_token" value="<%c++ Wishlist_tmp_stream << @@.get<std::string>("csrf_token"); %>">
                            <button class="w-6 h-6 bg-white/90 border border-slate-100 rounded-lg flex items-center justify-center text-slate-300 hover:text-red-500 hover:border-red-100 transition-all shadow-sm text-[10px] font-black">✕</button>
                        </form>
                        
                        <div class="aspect-square bg-slate-50 rounded-lg mb-3 flex items-center justify-center p-3 relative overflow-hidden">
                            <%c++ if (!p.at("image_url").empty()) { %>
                                <img src="<%c++ Wishlist_tmp_stream << p.at("image_url"); %>" class="max-h-full object-contain group-hover:scale-105 transition duration-500">
                            <%c++ } else { %> <span class="text-2xl">📦</span> <%c++ } %>
                        </div>
                        
                        <div class="space-y-1 mb-4 flex-grow px-1">
                            <h3 class="text-[10px] font-bold text-slate-700 line-clamp-1 leading-tight"><%c++ Wishlist_tmp_stream << p.at("title"); %></h3>
                            <p class="text-xs font-black text-slate-900"><%c++ Wishlist_tmp_stream << p.at("price"); %> so'm</p>
                        </div>
                        
                        <div class="flex flex-col gap-1.5 px-1">
                            <a href="/product/<%c++ Wishlist_tmp_stream << p.at("id"); %>" class="w-full py-2 btn-slate text-[9px] uppercase tracking-widest text-center">BATAFSIL</a>
                            <form action="/cart/add" method="POST" class="w-full">
                                <input type="hidden" name="csrf_token" value="<%c++ Wishlist_tmp_stream << @@.get<std::string>("csrf_token"); %>">
                                <input type="hidden" name="product_id" value="<%c++ Wishlist_tmp_stream << p.at("id"); %>">
                                <button class="w-full py-2 btn-amber text-[9px] uppercase tracking-widest shadow-lg shadow-amber-900/5">+ SAVATGA</button>
                            </form>
                        </div>
                    </div>
                <%c++ } %>
            </div>
        <%c++ } %>
    </main>

    <footer class="mt-auto py-8 text-center bg-white border-t border-slate-100">
        <p class="text-[9px] font-black text-slate-300 uppercase tracking-[0.2em]">© 2026 CYBERSHOP &middot; WISHLIST</p>
    </footer>
</body>
</html>
