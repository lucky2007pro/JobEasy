<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShop Admin | Mahsulotni tahrirlash</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style> 
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .sidebar { background: #ffffff; border-right: 1px solid #e2e8f0; }
        .sidebar-link { color: #64748b; transition: all 0.2s; border-radius: 8px; }
        .sidebar-link:hover { background: #f8fafc; color: #b45309; }
        .sidebar-link.active { background: #fef3c7; color: #b45309; font-weight: 700; }
        .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; }
        .btn-amber { background: #b45309; color: white; border-radius: 8px; transition: all 0.2s; }
        .btn-amber:hover { background: #92400e; }
        input, select, textarea { border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 14px; outline: none; transition: all 0.2s; background: #f8fafc; }
        input:focus, select:focus, textarea:focus { border-color: #b45309; background: white; }
    </style>
</head>
<body class="flex h-screen overflow-hidden">
    <%c++
        auto &product = @@.get<std::map<std::string, std::string>>("product");
        auto &categories = @@.get<std::vector<std::map<std::string, std::string>>>("categories_list");
    %>
    <aside class="w-64 sidebar flex flex-col z-30 shrink-0">
        <div class="p-6 flex items-center gap-2">
            <div class="w-7 h-7 bg-amber-700 rounded-lg flex items-center justify-center text-white font-black text-xs">C</div>
            <h2 class="text-base font-bold text-slate-800 tracking-tight">CyberShop Admin</h2>
        </div>
        <nav class="flex-grow px-4 space-y-1 mt-4">
            <a href="/admin/dashboard" class="sidebar-link active flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>📦</span> Mahsulotlar
            </a>
            <a href="/admin/analytics" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>📊</span> Analitika
            </a>
            <a href="/admin/orders" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>🚚</span> Buyurtmalar
            </a>
            <a href="/admin/categories" class="sidebar-link flex items-center gap-3 py-2.5 px-4 text-xs">
                <span>📁</span> Kategoriyalar
            </a>
        </nav>
    </aside>

    <main class="flex-1 overflow-y-auto flex flex-col">
        <header class="h-14 bg-white border-b border-slate-200 flex items-center justify-between px-8 sticky top-0 z-20">
            <div class="flex items-center gap-2 text-[11px] font-bold text-slate-400 uppercase tracking-widest">
                <span>Boshqaruv</span> <span class="text-slate-200">/</span> <span class="text-slate-800">Tahrirlash</span>
            </div>
        </header>

        <div class="p-8 max-w-4xl mx-auto w-full space-y-8">
            <div class="flex items-center gap-4">
                <a href="/admin/dashboard" class="text-[10px] font-black text-slate-400 hover:text-amber-700 uppercase tracking-widest bg-white border border-slate-200 px-4 py-2 rounded-lg transition">← Orqaga</a>
                <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Mahsulotni Tahrirlash</h1>
            </div>

            <div class="card p-10">
                <form action="/admin/product/edit/<%c++ EditProduct_tmp_stream << product.at("id"); %>" method="POST" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <input type="hidden" name="csrf_token" value="<%c++ EditProduct_tmp_stream << @@.get<std::string>("csrf_token"); %>">
                    <div class="flex flex-col gap-2">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Nomi</label>
                        <input type="text" name="title" value="<%c++ EditProduct_tmp_stream << product.at("title"); %>" class="text-sm font-bold text-slate-800" required>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Kategoriya</label>
                        <select name="category_id" class="text-sm font-bold text-slate-800">
                            <%c++ for(auto &cat : categories) { %>
                                <option value="<%c++ EditProduct_tmp_stream << cat.at("id"); %>" 
                                    <%c++ if(cat.at("id") == product.at("category_id")) EditProduct_tmp_stream << "selected"; %>>
                                    <%c++ EditProduct_tmp_stream << cat.at("name"); %>
                                </option>
                            <%c++ } %>
                        </select>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Narxi (so'm)</label>
                        <input type="number" step="0.01" name="price" value="<%c++ EditProduct_tmp_stream << product.at("price"); %>" class="text-sm font-bold text-slate-800" required>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Zaxira</label>
                        <input type="number" name="stock" value="<%c++ EditProduct_tmp_stream << product.at("stock"); %>" class="text-sm font-bold text-slate-800" required>
                    </div>
                    <div class="md:col-span-2 flex flex-col gap-2">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Tavsif</label>
                        <textarea name="description" rows="4" class="text-sm font-medium text-slate-600"><%c++ EditProduct_tmp_stream << product.at("description"); %></textarea>
                    </div>
                    <div class="md:col-span-2 flex flex-col gap-2">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Mahsulot rasmlari</label>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                            <%c++
                                auto &product_images = @@.get<std::vector<std::map<std::string, std::string>>>("product_images");
                                for(auto &img : product_images) {
                            %>
                            <div class="relative group h-40 bg-white border border-slate-100 rounded-xl overflow-hidden shadow-sm">
                                <img src="<%c++ EditProduct_tmp_stream << img.at("image_url"); %>" class="w-full h-full object-contain">
                                <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center gap-2">
                                    <button type="button" onclick="deleteImage('<%c++ EditProduct_tmp_stream << img.at("id"); %>')" class="p-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition shadow-lg">🗑️</button>
                                    <%c++ if (img.at("is_primary") == "0") { %>
                                        <button type="button" onclick="setPrimary('<%c++ EditProduct_tmp_stream << img.at("id"); %>')" class="p-2 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition shadow-lg">⭐️</button>
                                    <%c++ } %>
                                </div>
                                <%c++ if (img.at("is_primary") == "1") { %>
                                    <div class="absolute top-2 left-2 bg-amber-500 text-white text-[8px] font-black px-1.5 py-0.5 rounded uppercase tracking-widest shadow-sm">Asosiy</div>
                                <%c++ } %>
                            </div>
                            <%c++ } %>
                        </div>

                        <div class="border-2 border-dashed border-slate-100 rounded-2xl p-10 text-center hover:border-amber-400 hover:bg-amber-50/10 transition cursor-pointer relative group" 
                             onclick="document.getElementById('imgInput').click()">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Yangi rasmlar qo'shish</p>
                            <input type="file" id="imgInput" name="images" class="hidden" multiple onchange="previewImages(this)">
                        </div>
                        <div id="imgPreviews" class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4"></div>
                    </div>
                    <div class="md:col-span-2 pt-8 border-t border-slate-50 flex justify-end">
                        <button type="submit" class="btn-amber px-12 py-4 text-[11px] font-black uppercase tracking-widest shadow-xl shadow-amber-900/10">Saqlash</button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script>
        function previewImages(input) {
            const container = document.getElementById('imgPreviews');
            container.innerHTML = '';
            if (input.files) {
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const div = document.createElement('div');
                        div.className = 'h-32 rounded-xl overflow-hidden border border-slate-100 shadow-sm bg-white';
                        div.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-contain">`;
                        container.appendChild(div);
                    }
                    reader.readAsDataURL(file);
                });
            }
        }

        function deleteImage(id) {
            if(confirm('Ushbu rasmni o\'chirmoqchimisiz?')) {
                window.location.href = '/admin/product/image/delete/' + id;
            }
        }

        function setPrimary(id) {
            window.location.href = '/admin/product/image/primary/' + id;
        }
    </script>
</body>
</html>
